package ui

// formElement renders the <form> for Form, whose context carries the ID to the children.
templ formElement(p FormProps) {
	<form
		if p.ID != "" {
			id={ p.ID }
		}
		class={ p.layoutClass() }
		method={ p.Method.String() }
		if p.Action != "" {
			action={ templ.URL(p.Action) }
		}
		novalidate
		{ filterAttrs("Form", p.Attrs)... }
	>
		{ children... }
	</form>
}
