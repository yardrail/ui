package ui

// portalShell is the page frame shared by the portal mocks: a navbar, sidebar, and content area.
templ portalShell(title string, nav templ.Component) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/ui/ui.css"/>
			<script type="module" src="/static/ui/ui.js"></script>
			<link rel="stylesheet" href="/mocks.css"/>
		</head>
		<body style="margin:0;height:100%">
			<yr-page-workspace>
				<yr-navbar-std logo="/logo.png" brand="Yardrail" authed>
					<div class="yr-search yr-search--compact" slot="center" style="max-width:320px">
						@templ.Raw(exampleIcon("search", `class="yr-search-icon" style="left:0.5rem"`, navSearchIconSize))
						<input class="yr-search-input" type="search" placeholder="Search…" style="padding:var(--yr-space-1) var(--yr-space-2) var(--yr-space-1) 1.75rem;font-size:var(--yr-font-size-sm)"/>
					</div>
					<yr-account-menu name="Brahm Lower" email="brahm@yardrail.com">
						<span slot="avatar">BL</span>
						<a class="yr-dropdown-menu-item" href="#">Account settings</a>
						<a class="yr-dropdown-menu-item" href="#">Sign out</a>
					</yr-account-menu>
				</yr-navbar-std>
				@nav
				<yr-resize-handle target="sidebar"></yr-resize-handle>
				<yr-content>
					<yr-content-main>
						{ children... }
					</yr-content-main>
				</yr-content>
			</yr-page-workspace>
		</body>
	</html>
}

// portalNav is the portal sidebar with the link named active highlighted.
templ portalNav(active string) {
	<yr-sidebar>
		<yr-sidebar-header>
			<span style="font-family:var(--yr-font-body);font-weight:600;font-size:var(--yr-font-size-sm)">Yardrail</span>
		</yr-sidebar-header>
		<yr-sidebar-nav>
			@portalNavLink("home", "Home", portalHome, active)
			@portalNavLink("zap", "Automations", "automations", active)
		</yr-sidebar-nav>
		<yr-sidebar-nav label="Spaces">
			for _, l := range portalSpaceLinks() {
				@portalNavLink(l.icon, l.label, l.slug, active)
			}
		</yr-sidebar-nav>
		<yr-sidebar-nav bottom>
			@portalNavLink("settings", "Settings", "settings", active)
		</yr-sidebar-nav>
		<yr-sidebar-footer>
			<span style="font-size:var(--yr-font-size-xs);color:var(--yr-text-subtle)">v0.1.0</span>
		</yr-sidebar-footer>
	</yr-sidebar>
}

// portalNavAutomations is the portal sidebar with the Automations sub-links expanded.
templ portalNavAutomations(active string) {
	<yr-sidebar>
		<yr-sidebar-header>
			<span style="font-family:var(--yr-font-body);font-weight:600;font-size:var(--yr-font-size-sm)">Yardrail</span>
		</yr-sidebar-header>
		<yr-sidebar-nav>
			@portalNavLink("home", "Home", "", active)
			@portalNavLink("zap", "Automations", "automations", active)
		</yr-sidebar-nav>
		<yr-sidebar-nav>
			@portalNavLink("git-branch", "Workflows", "workflows", active)
			@portalNavLink("layout-grid", "Templates", "templates", active)
			@portalNavLink("plug", "Connectors", "connectors", active)
		</yr-sidebar-nav>
		<yr-sidebar-nav label="Spaces">
			for _, l := range portalSpaceLinks() {
				@portalNavLink(l.icon, l.label, l.slug, active)
			}
		</yr-sidebar-nav>
		<yr-sidebar-nav bottom>
			@portalNavLink("settings", "Settings", "settings", active)
		</yr-sidebar-nav>
		<yr-sidebar-footer>
			<span style="font-size:var(--yr-font-size-xs);color:var(--yr-text-subtle)">v0.1.0</span>
		</yr-sidebar-footer>
	</yr-sidebar>
}

// portalNavLink is one link in the portal sidebar, highlighted when link equals active.
templ portalNavLink(icon, label, link, active string) {
	<yr-sidebar-link href="#" { portalActive(link, active)... }>
		@Icon(icon)
		{ label }
	</yr-sidebar-link>
}

// --- Portal Home ---

templ portalHomePage() {
	@portalShell("Home · Yardrail", portalNav(portalHome)) {
		<h1 class="portal-page-title">Home</h1>
		<div class="portal-grid portal-grid-4" style="margin-bottom:var(--yr-space-8)">
			<div class="portal-stat-card">
				<p class="portal-stat-value">8</p>
				<p class="portal-stat-label">Active Workflows</p>
			</div>
			<div class="portal-stat-card" style="border-left:3px solid var(--yr-warning)">
				<p class="portal-stat-value">3</p>
				<p class="portal-stat-label">Waiting on You</p>
			</div>
			<div class="portal-stat-card">
				<p class="portal-stat-value">127</p>
				<p class="portal-stat-label">Runs This Week</p>
			</div>
			<div class="portal-stat-card">
				<p class="portal-stat-value">96%</p>
				<p class="portal-stat-label">Success Rate</p>
			</div>
		</div>
		<yr-section-header>Needs You <a href="#">View all</a></yr-section-header>
		<div style="margin-bottom:var(--yr-space-8)">
			@portalActionCard("clock", "amber", "Approve budget over $5k for Acme lead",
				"Waiting 2h 14m · Lead Scoring · Marketing Ops", "warning", "Waiting")
			@portalActionCard("clock", "amber", "Review generated newsletter draft",
				"Waiting 45m · Newsletter Digest · Marketing Ops", "warning", "Waiting")
		</div>
		<yr-section-header>Problems</yr-section-header>
		<div style="margin-bottom:var(--yr-space-8)">
			@portalActionCard("alert-triangle", "danger", "Social Scheduler failed",
				"Rate limit exceeded · 3 consecutive failures · 1h ago", "danger", "Failed")
		</div>
		@portalHomeActivity()
	}
}

templ portalActionCard(icon, badgeTone, title, desc, pillTone, pillText string) {
	<div class={ "yr-action-card", templ.KV("yr-action-card--urgent", pillTone == "warning"), templ.KV("yr-action-card--urgent-danger", pillTone == "danger") }>
		<div class={ "yr-icon-badge", "yr-icon-badge--" + badgeTone }>
			@Icon(icon)
		</div>
		<div class="yr-action-card-body">
			<h3 class="yr-action-card-title">{ title }</h3>
			<p class="yr-action-card-desc">{ desc }</p>
		</div>
		<div class="yr-action-card-action">
			<yr-pill tone={ pillTone } shape="pill">{ pillText }</yr-pill>
		</div>
	</div>
}

templ portalHomeActivity() {
	<yr-section-header>Recent Activity <a href="#">See more</a></yr-section-header>
	<yr-timeline-entries>
		@portalActivityRow("Newsletter Digest", "R-48", "success", "Completed", "3 outputs", "1m 23s", "", false)
		@portalActivityRow("Lead Scoring", "R-47", "warning", "Waiting", "Approve budget >$5k", "", "2026-10-01T09:00:00Z", false)
		@portalActivityRow("Social Scheduler", "R-46", "danger", "Failed", "Rate limit exceeded", "12s", "", true)
		@portalActivityRow("Contact Sync", "R-45", "success", "Completed", "24 records synced", "4m 8s", "", false)
		@portalActivityRow("Invoice Processor", "R-44", "success", "Completed", "12 invoices", "2m 51s", "", false)
	</yr-timeline-entries>
}

templ portalActivityRow(name, runID, tone, status, detail, duration, waitingSince string, isError bool) {
	if isError {
		<div class="yr-activity-row is-error">
			@portalActivityRowInner(name, runID, tone, status, detail, duration, waitingSince)
		</div>
	} else {
		<a class="yr-activity-row" href="#">
			@portalActivityRowInner(name, runID, tone, status, detail, duration, waitingSince)
		</a>
	}
}

templ portalActivityRowInner(name, runID, tone, status, detail, duration, waitingSince string) {
	<div>
		<div class="yr-activity-row-desc">{ name }</div>
		<div class="yr-activity-row-meta">
			<span class="yr-activity-row-id-badge">{ runID }</span>
			<yr-pill tone={ tone }>{ status }</yr-pill>
			<span>{ detail }</span>
		</div>
	</div>
	if waitingSince != "" {
		<div class="yr-activity-row-duration">
			<span class="yr-activity-row-duration-label">Waiting</span>
			<yr-live-duration started-at={ waitingSince }></yr-live-duration>
		</div>
	} else if duration != "" {
		<div class="yr-activity-row-duration">{ duration }</div>
	}
}

// --- Portal Automations ---

templ portalAutomationsPage() {
	@portalShell("Automations · Yardrail", portalNav("automations")) {
		<h1 class="portal-page-title">Automations</h1>
		<div class="portal-grid portal-grid-3" style="margin-bottom:var(--yr-space-8)">
			@portalAutoTile("git-branch", "accent", "Workflows", "7 active workflows across 4 spaces", "View all")
			@portalAutoTile("layout-grid", "purple", "Template Catalog", "Browse 500+ pre-built automation templates", "Browse")
			@portalAutoTile("plug", "amber", "Connectors", "4 tools connected to your organization", "Manage")
		</div>
		<yr-section-header>Connected Tools <a href="#">Manage</a></yr-section-header>
		<div style="display:flex;gap:var(--yr-space-3);margin-bottom:var(--yr-space-8)">
			<div class="yr-connector-pill--icon" title="Slack">
				<img src={ exampleLogo } alt="Slack" width="24" height="24"/>
			</div>
			<div class="yr-connector-pill--icon" title="HubSpot">HS</div>
			<div class="yr-connector-pill--icon" title="Google Sheets">GS</div>
			<div class="yr-connector-pill--icon" title="Stripe">ST</div>
		</div>
		<yr-section-header>Featured Templates <a href="#">View all</a></yr-section-header>
		<div class="portal-grid portal-grid-2">
			@portalTemplateCard("Refund triage",
				"Routes refund requests to the right approver and posts the decision back to the customer thread.",
				true, "4.5", "42", "$24")
			@portalTemplateCardCommunity("Weekly pipeline report",
				"Summarizes open deals every Monday and sends a digest to the sales team channel.",
				"1.2k installs", "Free")
		</div>
	}
}

templ portalAutoTile(icon, badgeTone, title, desc, action string) {
	<div class="yr-action-card">
		<div class={ "yr-icon-badge", "yr-icon-badge--" + badgeTone }>
			@Icon(icon)
		</div>
		<div class="yr-action-card-body">
			<h3 class="yr-action-card-title">{ title }</h3>
			<p class="yr-action-card-desc">{ desc }</p>
		</div>
		<div class="yr-action-card-action">
			<a href="#" class="yr-button yr-button--secondary">{ action }</a>
		</div>
	</div>
}

// --- Portal Workflows ---

templ portalWorkflowsPage() {
	@portalShell("Workflows · Yardrail", portalNavAutomations("workflows")) {
		<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--yr-space-6)">
			<h1 class="portal-page-title" style="margin-bottom:0">Workflows</h1>
			<button class="yr-button">+ New Workflow</button>
		</div>
		<form class="yr-search yr-search--compact" method="get" action="#" role="search" style="max-width:24rem;margin-bottom:var(--yr-space-4)">
			@templ.Raw(exampleIcon("search", `class="yr-search-icon"`, searchCompactIconSize))
			<input class="yr-search-input" type="search" name="q" placeholder="Search workflows…" autocomplete="off"/>
		</form>
		<div class="portal-grid portal-grid-4" style="margin-bottom:var(--yr-space-6)">
			<div class="portal-stat-card">
				<p class="portal-stat-value">14</p>
				<p class="portal-stat-label">Total</p>
			</div>
			<div class="portal-stat-card" style="border-left:3px solid var(--yr-success)">
				<p class="portal-stat-value">10</p>
				<p class="portal-stat-label">Active</p>
			</div>
			<div class="portal-stat-card" style="border-left:3px solid var(--yr-warning)">
				<p class="portal-stat-value">3</p>
				<p class="portal-stat-label">Paused</p>
			</div>
			<div class="portal-stat-card" style="border-left:3px solid var(--yr-danger)">
				<p class="portal-stat-value">1</p>
				<p class="portal-stat-label">Error</p>
			</div>
		</div>
		<div style="display:flex;flex-direction:column;gap:var(--yr-space-3)">
			@portalWorkflowRow("Newsletter Digest", "Marketing Ops", "success", "Active", "Last run 2h ago", "Trigger")
			@portalWorkflowRow("Lead Scoring", "Sales Ops", "", "Paused", "Last run 3d ago", "Resume")
			@portalWorkflowRow("Invoice Sync", "Client Onboarding", "success", "Active", "Last run 15m ago", "Trigger")
			@portalWorkflowRow("Social Scheduler", "Marketing Ops", "danger", "Error", "Failed 1h ago", "View")
			@portalWorkflowRow("Onboarding Flow", "Client Onboarding", "warning", "Draft", "", "Edit")
			@portalWorkflowRow("Ticket Router", "My Space", "success", "Active", "Last run 30m ago", "Trigger")
		</div>
	}
}

templ portalWorkflowRow(name, space, tone, status, lastRun, action string) {
	<div class="yr-list-row">
		<div class="yr-list-row-icon">
			@Icon("git-branch")
		</div>
		<div class="yr-list-row-main">
			<div class="yr-list-row-name">{ name }</div>
			<div class="yr-list-row-meta">
				<span>{ space }</span>
				<yr-pill tone={ tone } shape="pill">{ status }</yr-pill>
				if lastRun != "" {
					<span>{ lastRun }</span>
				}
			</div>
		</div>
		<div class="yr-list-row-actions">
			<button class="yr-button yr-button--secondary">{ action }</button>
		</div>
	</div>
}

// --- Portal Templates ---

templ portalTemplatesPage() {
	@portalShell("Template Catalog · Yardrail", portalNavAutomations("templates")) {
		<h1 class="portal-page-title">Template Catalog</h1>
		<form class="yr-search yr-search--hero" method="get" action="#" role="search" style="margin-bottom:var(--yr-space-4)">
			@templ.Raw(exampleIcon("search", `class="yr-search-icon"`, searchHeroIconSize))
			<input class="yr-search-input" type="search" name="q" placeholder="Search 500+ templates…" autocomplete="off"/>
		</form>
		<div style="display:flex;gap:var(--yr-space-2);margin-bottom:var(--yr-space-6)">
			<yr-pill tone="accent" class="is-active">All</yr-pill>
			<yr-pill>Marketing</yr-pill>
			<yr-pill>Sales</yr-pill>
			<yr-pill>Operations</yr-pill>
			<yr-pill>HR</yr-pill>
			<yr-pill>Finance</yr-pill>
		</div>
		<div class="portal-grid portal-grid-3">
			@portalTemplateCard("Refund triage",
				"Routes refund requests to the right approver and posts the decision back to the customer thread.",
				true, "4.5", "42", "$24")
			@portalTemplateCardCommunity("Weekly pipeline report",
				"Summarizes open deals and pipeline movement every Monday morning in a Slack digest.",
				"1.2k installs", "Free")
			@portalTemplateCard("New hire onboarding",
				"Creates accounts, sends welcome emails, and schedules orientation for new team members.",
				true, "4.8", "128", "$18")
			@portalTemplateCardCommunity("Lead enrichment",
				"Enriches inbound leads with firmographic data and scores them for sales readiness.",
				"890 installs", "Free")
			@portalTemplateCard("Invoice reconciliation",
				"Matches invoices against purchase orders and flags discrepancies for review.",
				true, "4.2", "31", "$36")
			@portalTemplateCardCommunity("Social listening digest",
				"Aggregates brand mentions across social platforms into a weekly Slack summary.",
				"2.1k installs", "Free")
		</div>
	}
}

templ portalTemplateCard(name, desc string, verified bool, rating, reviews, price string) {
	<a href="#" class="yr-card yr-card--interactive yr-template-card">
		<h3 class="yr-template-card-name">{ name }</h3>
		<p class="yr-template-card-desc">{ desc }</p>
		<div class="yr-card-footer">
			<div class="yr-template-card-footer-left">
				if verified {
					<yr-pill tone="accent">Verified</yr-pill>
				}
				<yr-rating value={ rating } reviews={ reviews }></yr-rating>
			</div>
			<span class="yr-template-card-price">{ price }</span>
		</div>
	</a>
}

templ portalTemplateCardCommunity(name, desc, installs, price string) {
	<a href="#" class="yr-card yr-card--interactive yr-template-card">
		<h3 class="yr-template-card-name">{ name }</h3>
		<p class="yr-template-card-desc">{ desc }</p>
		<div class="yr-card-footer">
			<div class="yr-template-card-footer-left">
				<yr-pill tone="purple">Community</yr-pill>
				<span class="yr-template-card-install-count">{ installs }</span>
			</div>
			<span class="yr-template-card-price">{ price }</span>
		</div>
	</a>
}

// --- Portal Connectors ---

templ portalConnectorsPage() {
	@portalShell("Connectors · Yardrail", portalNavAutomations("connectors")) {
		<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--yr-space-6)">
			<h1 class="portal-page-title" style="margin-bottom:0">Connectors</h1>
			<button class="yr-button">+ Add Connector</button>
		</div>
		<yr-section-header>Connected</yr-section-header>
		<div style="display:flex;flex-direction:column;gap:var(--yr-space-3);margin-bottom:var(--yr-space-8)">
			@portalConnectorRow("", "Slack", "workspace-prod", "success", "Connected", true)
			@portalConnectorRow("HS", "HubSpot", "marketing-hub", "success", "Connected", false)
			@portalConnectorRow("GS", "Google Sheets", "ops-shared@acme.com", "success", "Connected", false)
			@portalConnectorRow("ST", "Stripe", "prod-account", "warning", "Expiring", false)
		</div>
		<yr-section-header>Available</yr-section-header>
		<div style="display:flex;flex-direction:column;gap:var(--yr-space-3)">
			@portalAvailableConnector("JI", "Jira", "Project management and issue tracking")
			@portalAvailableConnector("SF", "Salesforce", "CRM and sales pipeline management")
			@portalAvailableConnector("ZD", "Zendesk", "Customer support and ticketing")
		</div>
	}
}

templ portalConnectorRow(initials, name, meta, tone, status string, hasLogo bool) {
	<div class="yr-list-row">
		if hasLogo {
			<div class="yr-list-row-icon">
				<img src={ exampleLogo } alt={ name } width="40" height="40"/>
			</div>
		} else {
			<div class="yr-list-row-icon" style="background:var(--yr-surface-muted);font-family:var(--yr-font-ui);font-weight:600;font-size:var(--yr-font-size-sm);color:var(--yr-text-muted)">
				{ initials }
			</div>
		}
		<div class="yr-list-row-main">
			<div class="yr-list-row-name">{ name }</div>
			<div class="yr-list-row-meta">
				<span>{ meta }</span>
				<yr-pill tone={ tone } shape="pill">{ status }</yr-pill>
			</div>
		</div>
		<div class="yr-list-row-actions">
			<button class="yr-button yr-button--secondary">Manage</button>
		</div>
	</div>
}

templ portalAvailableConnector(initials, name, desc string) {
	<div class="yr-list-row">
		<div class="yr-list-row-icon" style="background:var(--yr-surface-muted);font-family:var(--yr-font-ui);font-weight:600;font-size:var(--yr-font-size-sm);color:var(--yr-text-muted)">
			{ initials }
		</div>
		<div class="yr-list-row-main">
			<div class="yr-list-row-name">{ name }</div>
			<div class="yr-list-row-desc">{ desc }</div>
		</div>
		<div class="yr-list-row-actions">
			<button class="yr-button">Connect</button>
		</div>
	</div>
}

// --- Portal Space ---

templ portalSpacePage() {
	@portalShell("Marketing Ops · Yardrail", portalNav("space-marketing")) {
		<div class="space-header">
			<div class="space-header-title">
				<h1 class="portal-page-title" style="margin-bottom:0">Marketing Ops</h1>
			</div>
			<div class="space-header-meta">
				<div class="space-header-members">
					<yr-avatar>AL</yr-avatar>
					<yr-avatar>MK</yr-avatar>
					<yr-avatar>JS</yr-avatar>
					<span class="space-header-member-count">3 members</span>
				</div>
				<button class="yr-button yr-button--secondary">Settings</button>
			</div>
		</div>
		<yr-section-header>Installed Workflows <a href="#">Install new</a></yr-section-header>
		<div class="portal-grid portal-grid-3" style="margin-bottom:var(--yr-space-8)">
			@portalWorkflowCard("Lead Scoring", "warning", "Waiting", "42", "91%", "Waiting for input", "View")
			@portalWorkflowCard("Newsletter Digest", "success", "Active", "127", "98%", "Last run 2h ago", "Trigger")
			@portalWorkflowCard("Social Scheduler", "", "Paused", "18", "85%", "Last run 1d ago", "Resume")
		</div>
		<yr-section-header>Recent Activity <a href="#">View all</a></yr-section-header>
		<yr-timeline-entries>
			@portalActivityRow("Newsletter Digest", "R-45", "success", "Completed", "3 outputs", "1m 23s", "", false)
			@portalActivityRow("Lead Scoring", "R-44", "warning", "Waiting", "Approve budget >$5k", "", "2026-10-11T08:00:00Z", false)
			@portalActivityRow("Newsletter Digest", "R-43", "success", "Completed", "2 outputs", "58s", "", false)
			@portalActivityRow("Social Scheduler", "R-42", "danger", "Failed", "Rate limit exceeded", "12s", "", true)
			@portalActivityRow("Lead Scoring", "R-41", "success", "Completed", "1 output", "4m 12s", "", false)
		</yr-timeline-entries>
	}
}

templ portalWorkflowCard(name, tone, status, runs, success, footer, action string) {
	<yr-workflow-card>
		<div class="yr-workflow-card-header">
			<span class="yr-workflow-card-name">{ name }</span>
			<yr-pill tone={ tone } shape="pill">{ status }</yr-pill>
		</div>
		<div class="yr-workflow-card-stats">
			<yr-stat number={ runs } label="Runs"></yr-stat>
			<yr-stat number={ success } label="Success"></yr-stat>
		</div>
		<div class="yr-workflow-card-footer">
			<span>{ footer }</span>
			if action == "View" {
				<a href="#" class="yr-button yr-button--secondary">{ action }</a>
			} else {
				<button class="yr-button yr-button--secondary">{ action }</button>
			}
		</div>
	</yr-workflow-card>
}

// --- Portal Workflow Detail ---

templ portalWorkflowDetailPage() {
	@portalShell("Newsletter Digest · Yardrail", portalNav("space-marketing")) {
		<nav class="yr-breadcrumb">
			<a href="#">Home</a>
			<span class="yr-breadcrumb-sep">/</span>
			<a href="#">Marketing Ops</a>
			<span class="yr-breadcrumb-sep">/</span>
			<span class="yr-breadcrumb-current">Newsletter Digest</span>
		</nav>
		<h1 class="portal-page-title">Newsletter Digest</h1>
		<yr-status-banner tone="success" style="margin-bottom:var(--yr-space-6)">
			<yr-pill tone="success" shape="pill">Active</yr-pill>
			<span class="yr-status-banner-message">Running on schedule. Last triggered 2h ago.</span>
			<div class="yr-status-banner-actions">
				<button class="yr-button yr-button--secondary">Pause</button>
				<button class="yr-button yr-button--secondary">Trigger Now</button>
			</div>
		</yr-status-banner>
		<yr-tabs label="Workflow details">
			<button slot="tab" data-tab="runs">Runs</button>
			<button slot="tab" data-tab="config">Configuration</button>
			@portalWorkflowDetailRuns()
			@portalWorkflowDetailConfig()
		</yr-tabs>
	}
}

templ portalWorkflowDetailRuns() {
	<div slot="panel" data-tab="runs">
		<yr-section-header>Needs Attention</yr-section-header>
		<a class="yr-activity-row" href="#" style="margin-bottom:var(--yr-space-6)">
			<div>
				<div class="yr-activity-row-desc">Approve newsletter content draft</div>
				<div class="yr-activity-row-meta">
					<span class="yr-activity-row-id-badge">R-49</span>
					<yr-pill tone="warning">Waiting</yr-pill>
					<span>Content review required</span>
				</div>
			</div>
			<div class="yr-activity-row-duration">
				<span class="yr-activity-row-duration-label">Waiting</span>
				<yr-live-duration started-at="2026-10-11T12:00:00Z"></yr-live-duration>
			</div>
		</a>
		<yr-section-header>Recent Runs</yr-section-header>
		<yr-timeline-entries>
			@portalActivityRow("Newsletter Digest", "R-48", "success", "Completed", "3 outputs", "1m 23s", "", false)
			@portalActivityRow("Newsletter Digest", "R-47", "success", "Completed", "3 outputs", "58s", "", false)
			@portalActivityRow("Newsletter Digest", "R-46", "success", "Completed", "3 outputs", "1m 05s", "", false)
			@portalActivityRow("Newsletter Digest", "R-45", "danger", "Failed", "SendGrid 429 — rate limit exceeded", "12s", "", true)
		</yr-timeline-entries>
	</div>
}

templ portalWorkflowDetailConfig() {
	<div slot="panel" data-tab="config">
		<yr-section-header>Triggers</yr-section-header>
		<div style="display:flex;flex-direction:column;gap:var(--yr-space-2);margin-bottom:var(--yr-space-6)">
			<div class="yr-meta-row">
				<span>Webhook</span>
				<code style="font-family:var(--yr-font-mono);font-size:var(--yr-font-size-sm);color:var(--yr-text-muted)">https://api.yardrail.com/wh/abc123</code>
			</div>
			<div class="yr-meta-row">
				<span>Manual</span>
				<yr-pill tone="success">Enabled</yr-pill>
			</div>
		</div>
		<yr-section-header>Connector Bindings</yr-section-header>
		<div style="display:flex;flex-direction:column;gap:var(--yr-space-2);margin-bottom:var(--yr-space-6)">
			<div class="yr-meta-row">
				<span>email.send</span>
				<span>SendGrid</span>
				<yr-pill tone="success" shape="pill">Bound</yr-pill>
			</div>
			<div class="yr-meta-row">
				<span>crm.read</span>
				<span>HubSpot</span>
				<yr-pill tone="success" shape="pill">Bound</yr-pill>
			</div>
			<div class="yr-meta-row">
				<span>file.store</span>
				<span>Google Drive</span>
				<yr-pill tone="success" shape="pill">Bound</yr-pill>
			</div>
		</div>
		<yr-section-header>Schedule</yr-section-header>
		<div style="margin-bottom:var(--yr-space-6)">
			<div class="yr-meta-row">
				<span>Frequency</span>
				<span>Every weekday at 8:00 AM UTC</span>
			</div>
		</div>
		<yr-section-header>Inference Backend</yr-section-header>
		<div class="yr-meta-row">
			<span>Model</span>
			<span>Claude Sonnet · temperature 0.3 · max 2048 tokens</span>
		</div>
	</div>
}

// --- Portal Workflow Run ---

templ portalWorkflowRunPage() {
	@portalShell("Run #42 · Newsletter Digest · Yardrail", portalNav("space-marketing")) {
		<nav class="yr-breadcrumb">
			<a href="#">Home</a>
			<span class="yr-breadcrumb-sep">/</span>
			<a href="#">Marketing Ops</a>
			<span class="yr-breadcrumb-sep">/</span>
			<a href="#">Newsletter Digest</a>
			<span class="yr-breadcrumb-sep">/</span>
			<span class="yr-breadcrumb-current">Run #42</span>
		</nav>
		<h1 class="portal-page-title">Run #42</h1>
		<div class="yr-meta-row" style="margin-bottom:var(--yr-space-6)">
			<yr-pill tone="warning" shape="pill">Waiting</yr-pill>
			<span>Started Oct 11, 2026 at 2:30 PM</span>
			<yr-live-duration started-at="2026-10-11T14:30:00Z"></yr-live-duration>
			<span>Triggered by schedule</span>
		</div>
		<yr-hitl-prompt tone="warning" style="margin-bottom:var(--yr-space-8)">
			<div class="yr-hitl-prompt-title">Approve the content draft for this week's newsletter?</div>
			<p class="yr-hitl-prompt-desc">
				The workflow generated a newsletter draft from 12 recent blog posts and 3 product updates. Review the draft in the outputs below before approving.
			</p>
			<div class="yr-hitl-prompt-actions">
				<button class="yr-button">Approve</button>
				<button class="yr-button yr-button--secondary">Request Changes</button>
			</div>
		</yr-hitl-prompt>
		<yr-section-header>Outputs</yr-section-header>
		<yr-download-list style="margin-bottom:var(--yr-space-8)">
			<a href="#" download>
				@Icon("file-text")
				{ " newsletter-draft.html" }
				<span class="yr-download-size">84 KB</span>
			</a>
			<a href="#" download>
				@Icon("file-spreadsheet")
				{ " recipient-list.csv" }
				<span class="yr-download-size">156 KB</span>
			</a>
		</yr-download-list>
		<yr-section-header>Journal</yr-section-header>
		<yr-journal-log>
			@portalJournalEntry("Run started — triggered by schedule", "step-1", "trigger.schedule", "2026-10-11T14:30:00Z", "14:30:00")
			@portalJournalEntry("Fetched 12 blog posts from CMS", "step-2", "content.fetch", "2026-10-11T14:30:04Z", "14:30:04")
			@portalJournalEntry("Fetched 3 product updates from Notion", "step-3", "content.fetch", "2026-10-11T14:30:09Z", "14:30:09")
			@portalJournalEntry("Generated newsletter draft (1,240 words)", "step-4", "ai.generate", "2026-10-11T14:30:18Z", "14:30:18")
			@portalJournalEntry("Queried recipient list — 2,847 subscribers", "step-5", "list.query", "2026-10-11T14:30:22Z", "14:30:22")
			@portalJournalEntry("Wrote newsletter-draft.html", "step-6", "output.write", "2026-10-11T14:30:25Z", "14:30:25")
			@portalJournalEntry("Waiting for approval — content review required", "wait", "input.request", "2026-10-11T14:30:26Z", "14:30:26")
		</yr-journal-log>
	}
}

templ portalJournalEntry(desc, stepID, stepType, datetime, display string) {
	<div class="yr-activity-row">
		<div>
			<div class="yr-activity-row-desc">{ desc }</div>
			<div class="yr-activity-row-meta">
				<span class="yr-activity-row-id-badge">{ stepID }</span>
				{ stepType }
			</div>
		</div>
		<time class="yr-activity-row-timestamp" datetime={ datetime }>{ display }</time>
	</div>
}
