{
  "name": "@yardrail/ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:css",
    "build:js": "esbuild index.ts --bundle --format=esm --target=es2022 --outfile=pkg/dist/ui.js --sourcemap",
    "build:css": "esbuild styles.css --bundle --outfile=pkg/dist/ui.css --sourcemap --external:/fonts/*",
    "watch": "pnpm run watch:js & pnpm run watch:css",
    "watch:js": "pnpm run build:js -- --watch",
    "watch:css": "pnpm run build:css -- --watch"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {}
}
