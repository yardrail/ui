{
  "name": "@yardrail/ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:css",
    "build:js": "esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=pkg/dist/ui.js --sourcemap",
    "build:css": "esbuild src/styles.css --bundle --outfile=pkg/dist/ui.css --sourcemap --external:/fonts/*",
    "watch": "pnpm run watch:js & pnpm run watch:css",
    "watch:js": "pnpm run build:js -- --watch",
    "watch:css": "pnpm run build:css -- --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.13.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0"
  }
}
