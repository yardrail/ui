package ui

// SearchVariant is the visual style of a Search form.
type SearchVariant struct{ v string }

var (
	SearchPlain   = SearchVariant{v: "plain"}
	SearchHero    = SearchVariant{v: "hero"}
	SearchCompact = SearchVariant{v: "compact"}
)

func (v SearchVariant) class() string {
	if v.v == "plain" {
		return "yr-search"
	}
	return "yr-search yr-search--" + v.v
}

// SearchProps configures a Search form.
type SearchProps struct {
	Variant     SearchVariant
	Placeholder string
	Action      string
	Name        string
	Attrs       templ.Attributes
}

func (p *SearchProps) action() string {
	if p.Action != "" {
		return p.Action
	}

	return "#"
}

func (p *SearchProps) name() string {
	if p.Name != "" {
		return p.Name
	}

	return "q"
}

// Search renders a search form with icon and input.
func Search(p *SearchProps) templ.Component {
	return search(p)
}

templ search(p *SearchProps) {
	<form class={ p.Variant.class() } method="get" action={ templ.SafeURL(p.action()) } role="search" { filterAttrs("Search", p.Attrs)... }>
		<span class="yr-search-icon">
			@IconSearch()
		</span>
		<input class="yr-search-input" type="search" name={ p.name() } placeholder={ p.Placeholder } autocomplete="off"/>
	</form>
}
