package ui

// Search variants.
const (
	SearchHero    = "hero"
	SearchCompact = "compact"
)

// SearchProps configures a Search form.
type SearchProps struct {
	Variant     string
	Placeholder string
	Action      string
	Name        string
	Attrs       templ.Attributes
}

func (p *SearchProps) class() string {
	if p.Variant != "" {
		return "yr-search yr-search--" + p.Variant
	}

	return "yr-search"
}

func (p *SearchProps) action() string {
	if p.Action != "" {
		return p.Action
	}

	return "#"
}

func (p *SearchProps) name() string {
	if p.Name != "" {
		return p.Name
	}

	return "q"
}

// Search renders a search form with icon and input.
func Search(p *SearchProps) templ.Component {
	return search(p)
}

templ search(p *SearchProps) {
	<form class={ p.class() } method="get" action={ templ.SafeURL(p.action()) } role="search" { filterAttrs("Search", p.Attrs)... }>
		<span class="yr-search-icon">
			@IconSearch()
		</span>
		<input class="yr-search-input" type="search" name={ p.name() } placeholder={ p.Placeholder } autocomplete="off"/>
	</form>
}
