package ui

templ iconBadgeTonesExample() {
	<div style="display:flex;flex-wrap:wrap;gap:1rem">
		@iconBadgeExampleItem("accent", "pencil")
		@iconBadgeExampleItem("amber", "mail")
		@iconBadgeExampleItem("blue", "star")
		@iconBadgeExampleItem("green", "check-circle")
		@iconBadgeExampleItem("purple", "shield")
		@iconBadgeExampleItem("pink", "user")
		@iconBadgeExampleItem("danger", "zap")
	</div>
}

templ iconBadgeExampleItem(tone, iconName string) {
	<div style="display:flex;flex-direction:column;align-items:center;gap:0.5rem">
		@IconBadge(tone, &IconBadgeProps{}) {
			@Icon(iconName)
		}
		<code style="font-size:0.75rem;color:#5C5A59">{ tone }</code>
	</div>
}
