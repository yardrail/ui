package ui

// SidebarProps configures a Sidebar.
type SidebarProps struct {
	Collapsed bool
	Attrs     templ.Attributes
}

// Sidebar renders the main navigation sidebar.
func Sidebar(p *SidebarProps) templ.Component {
	return sidebarComponent(p)
}

// SidebarHeaderProps configures a SidebarHeader.
type SidebarHeaderProps struct {
	Attrs templ.Attributes
}

// SidebarHeader renders the header region of a sidebar.
func SidebarHeader(p *SidebarHeaderProps) templ.Component {
	return sidebarHeader(p)
}

// SidebarNavProps configures a SidebarNav.
type SidebarNavProps struct {
	Label  string
	Bottom bool
	Attrs  templ.Attributes
}

// SidebarNav renders a navigation group within a sidebar.
func SidebarNav(p *SidebarNavProps) templ.Component {
	return sidebarNav(p)
}

// SidebarLinkProps configures a SidebarLink.
type SidebarLinkProps struct {
	Href   string
	Active bool
	Attrs  templ.Attributes
}

// SidebarLink renders a single navigation link within a sidebar nav group.
func SidebarLink(p *SidebarLinkProps) templ.Component {
	return sidebarLink(p)
}

// SidebarOrgProps configures a SidebarOrg.
type SidebarOrgProps struct {
	Name    string
	Initial string
	Attrs   templ.Attributes
}

// SidebarOrg renders an organization badge within a sidebar.
func SidebarOrg(p *SidebarOrgProps) templ.Component {
	return sidebarOrg(p)
}

// SidebarFooterProps configures a SidebarFooter.
type SidebarFooterProps struct {
	Attrs templ.Attributes
}

// SidebarFooter renders the footer region of a sidebar.
func SidebarFooter(p *SidebarFooterProps) templ.Component {
	return sidebarFooter(p)
}

templ sidebarComponent(p *SidebarProps) {
	<yr-sidebar
		if p.Collapsed {
			collapsed
		}
		{ filterAttrs("Sidebar", p.Attrs)... }
	>
		{ children... }
	</yr-sidebar>
}

templ sidebarHeader(p *SidebarHeaderProps) {
	<yr-sidebar-header { filterAttrs("SidebarHeader", p.Attrs)... }>
		<button type="button" class="yr-sidebar-toggle" aria-label="Toggle sidebar">
			@IconPanelLeftClose()
			@IconPanelLeftOpen()
		</button>
		{ children... }
	</yr-sidebar-header>
}

templ sidebarNav(p *SidebarNavProps) {
	<yr-sidebar-nav
		label={ p.Label }
		if p.Bottom {
			bottom
		}
		{ filterAttrs("SidebarNav", p.Attrs)... }
	>
		{ children... }
	</yr-sidebar-nav>
}

templ sidebarLink(p *SidebarLinkProps) {
	<yr-sidebar-link
		href={ p.Href }
		if p.Active {
			active
		}
		{ filterAttrs("SidebarLink", p.Attrs)... }
	>
		{ children... }
	</yr-sidebar-link>
}

templ sidebarOrg(p *SidebarOrgProps) {
	<yr-sidebar-org { filterAttrs("SidebarOrg", p.Attrs)... }>
		<span class="yr-sidebar-org-pfp">{ sidebarOrgInitial(p) }</span>
		<span class="yr-sidebar-org-name">{ p.Name }</span>
	</yr-sidebar-org>
}

func sidebarOrgInitial(p *SidebarOrgProps) string {
	if p.Initial != "" {
		return p.Initial
	}

	if p.Name != "" {
		return string([]rune(p.Name)[0])
	}

	return ""
}

templ sidebarFooter(p *SidebarFooterProps) {
	<yr-sidebar-footer { filterAttrs("SidebarFooter", p.Attrs)... }>
		{ children... }
	</yr-sidebar-footer>
}
