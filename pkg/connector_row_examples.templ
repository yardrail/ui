package ui

templ connectorRowExampleRows() {
	<div style="display:flex;flex-direction:column;gap:0.75rem;max-width:44rem">
		@ListRow(&ListRowProps{}) {
			<div class="yr-list-row-icon">
				<img src={ exampleLogo } alt="Slack" width="40" height="40"/>
			</div>
			<div class="yr-list-row-main">
				<div class="yr-list-row-name">Slack</div>
				<div class="yr-list-row-meta">
					<span>workspace-prod</span>
					@Pill("Connected", &PillProps{Tone: "success", Shape: ShapePill})
				</div>
			</div>
			<div class="yr-list-row-actions">
				<a href="#" class="yr-button yr-button--secondary">Manage</a>
			</div>
		}
		@ListRow(&ListRowProps{}) {
			<div class="yr-list-row-icon">
				<img src={ exampleLogo } alt="HubSpot" width="40" height="40"/>
			</div>
			<div class="yr-list-row-main">
				<div class="yr-list-row-name">HubSpot</div>
				<div class="yr-list-row-meta">
					<span>marketing-hub</span>
					@Pill("Connected", &PillProps{Tone: "success", Shape: ShapePill})
				</div>
			</div>
			<div class="yr-list-row-actions">
				<a href="#" class="yr-button yr-button--secondary">Manage</a>
			</div>
		}
		@ListRow(&ListRowProps{}) {
			<div class="yr-list-row-icon">
				<img src={ exampleLogo } alt="Jira" width="40" height="40"/>
			</div>
			<div class="yr-list-row-main">
				<div class="yr-list-row-name">Jira</div>
				<div class="yr-list-row-meta">
					@Pill("Disconnected", &PillProps{Tone: "danger", Shape: ShapePill})
				</div>
			</div>
			<div class="yr-list-row-actions">
				<a href="#" class="yr-button">Connect</a>
			</div>
		}
	</div>
}
