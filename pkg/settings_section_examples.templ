package ui

templ settingsSectionAvatarRow() {
	@SettingsSection(&SettingsSectionProps{}) {
		<h2>Profile photo</h2>
		<p class="yr-settings-section-success">Your photo has been updated.</p>
		<div class="yr-settings-section-avatar-row">
			@Avatar("BL", &AvatarProps{Size: "lg"})
			<form method="post" action="#" enctype="multipart/form-data">
				<input type="file" name="avatar" accept="image/png,image/jpeg" required/>
				@Button("Upload", ButtonProps{Variant: ButtonPrimary, Type: ButtonSubmit})
			</form>
		</div>
	}
}

templ settingsSectionFieldRow() {
	@SettingsSection(&SettingsSectionProps{}) {
		<h2>Display name</h2>
		@Form(FormProps{}) {
			@Field("Display name", "settings-display-name", FieldProps{Value: "Blake Lindqvist"})
			<div>
				@Button("Save", ButtonProps{Variant: ButtonPrimary, Type: ButtonSubmit})
			</div>
		}
	}
}
