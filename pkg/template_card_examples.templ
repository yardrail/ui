package ui

templ templateCardGrid() {
	<div style="display:grid;grid-template-columns:repeat(2,minmax(0,20rem));gap:1rem">
		@TemplateCard("Refund triage",
			"Routes refund requests to the right approver and posts the decision back to the customer thread.",
			"$24", &TemplateCardProps{
				Connectors: templateCardConnectors(),
				FooterLeft: templateCardVerifiedFooter("4.5", "42"),
			})
		@TemplateCard("Weekly pipeline report",
			"Summarizes open deals every Monday.",
			"Free", &TemplateCardProps{
				FooterLeft: templateCardCommunityFooter("1.2k installs"),
			})
	</div>
}

templ templateCardConnectors() {
	@ConnectorPill(&ConnectorPillProps{Title: "Slack"}) {
		<img src={ exampleLogo } alt="Slack"/>
	}
	@ConnectorPill(&ConnectorPillProps{Title: "HubSpot"}) {
		HS
	}
}

templ templateCardVerifiedFooter(value, reviews string) {
	@Pill("Verified", &PillProps{Tone: "accent"})
	@Rating(value, &RatingProps{Reviews: reviews})
}

templ templateCardCommunityFooter(installs string) {
	@Pill("Community", &PillProps{Tone: "purple"})
	<span class="yr-template-card-install-count">{ installs }</span>
}
