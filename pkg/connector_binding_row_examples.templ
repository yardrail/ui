package ui

templ connectorBindingRowExampleRows() {
	<div style="display:flex;flex-direction:column;gap:0.75rem;max-width:36rem">
		@MetaRow(&MetaRowProps{}) {
			<span>email.send</span>
			<span>SendGrid</span>
			@Pill("Bound", &PillProps{Tone: "success", Shape: ShapePill})
		}
		@MetaRow(&MetaRowProps{}) {
			<span>crm.read</span>
			<span>HubSpot</span>
			@Pill("Bound", &PillProps{Tone: "success", Shape: ShapePill})
		}
		@MetaRow(&MetaRowProps{}) {
			<span>chat.post</span>
			@Pill("Not connected", &PillProps{Tone: "danger", Shape: ShapePill})
			<a href="#" style="font-family:var(--yr-font-ui);font-size:var(--yr-font-size-sm);color:var(--yr-accent)">Set up</a>
		}
	</div>
}
