package ui

// StatProps configures a Stat.
type StatProps struct {
	Label string
	Attrs templ.Attributes
}

// Stat renders a number + label pair.
func Stat(number string, p *StatProps) templ.Component {
	return stat(number, p)
}

templ stat(number string, p *StatProps) {
	<yr-stat { filterAttrs("Stat", p.Attrs)... }>
		<span class="yr-stat-number">{ number }</span>
		<span class="yr-stat-label">{ p.Label }</span>
	</yr-stat>
}
