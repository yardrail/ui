package ui

templ workflowRowExampleRows() {
	<div style="display:flex;flex-direction:column;gap:0.75rem;max-width:44rem">
		@ListRow(&ListRowProps{}) {
			<div class="yr-list-row-icon">
				@Icon("git-branch")
			</div>
			<div class="yr-list-row-main">
				<div class="yr-list-row-name">Newsletter Digest</div>
				<div class="yr-list-row-meta">
					<span>Marketing Ops</span>
					@Pill("Active", &PillProps{Tone: "success", Shape: ShapePill})
					<span>Last run 2h ago</span>
				</div>
			</div>
			<div class="yr-list-row-actions">
				@Button("Trigger", ButtonProps{Variant: ButtonSecondary})
			</div>
		}
		@ListRow(&ListRowProps{}) {
			<div class="yr-list-row-icon">
				@Icon("git-branch")
			</div>
			<div class="yr-list-row-main">
				<div class="yr-list-row-name">Lead Scoring</div>
				<div class="yr-list-row-meta">
					<span>Sales Ops</span>
					@Pill("Paused", &PillProps{Shape: ShapePill})
					<span>Last run 3d ago</span>
				</div>
			</div>
			<div class="yr-list-row-actions">
				@Button("Resume", ButtonProps{Variant: ButtonSecondary})
			</div>
		}
		@ListRow(&ListRowProps{}) {
			<div class="yr-list-row-icon">
				@Icon("git-branch")
			</div>
			<div class="yr-list-row-main">
				<div class="yr-list-row-name">Social Scheduler</div>
				<div class="yr-list-row-meta">
					<span>Marketing Ops</span>
					@Pill("Error", &PillProps{Tone: "danger", Shape: ShapePill})
					<span>Failed 1h ago</span>
				</div>
			</div>
			<div class="yr-list-row-actions">
				@Button("View", ButtonProps{Variant: ButtonSecondary})
			</div>
		}
		@ListRow(&ListRowProps{}) {
			<div class="yr-list-row-icon">
				@Icon("git-branch")
			</div>
			<div class="yr-list-row-main">
				<div class="yr-list-row-name">Onboarding Flow</div>
				<div class="yr-list-row-meta">
					<span>Client Onboarding</span>
					@Pill("Draft", &PillProps{Tone: "warning", Shape: ShapePill})
				</div>
			</div>
			<div class="yr-list-row-actions">
				@Button("Edit", ButtonProps{Variant: ButtonSecondary})
			</div>
		}
	</div>
}
