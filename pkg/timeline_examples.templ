package ui

templ timelineDefault() {
	<div style="max-width:44rem">
		@TimelineGroup(&TimelineGroupProps{}) {
			<time datetime="2026-10-11">Today</time>
			@TimelineEntries(&TimelineEntriesProps{}) {
				@ActivityRow(&ActivityRowProps{Href: "#"}) {
					<div>
						<div class="yr-activity-row-desc">Newsletter Digest</div>
						<div class="yr-activity-row-meta">
							<span class="yr-activity-row-id-badge">R-45</span>
							@Pill("Completed", &PillProps{Tone: "success", Shape: ShapePill})
							<span>3 outputs</span>
						</div>
					</div>
					<div class="yr-activity-row-duration">
						<span class="yr-activity-row-duration-label">1m 23s</span>
					</div>
				}
				@ActivityRow(&ActivityRowProps{Href: "#"}) {
					<div>
						<div class="yr-activity-row-desc">Lead Scoring</div>
						<div class="yr-activity-row-meta">
							<span class="yr-activity-row-id-badge">R-44</span>
							@Pill("Waiting", &PillProps{Tone: "warning", Shape: ShapePill})
							<span>Approve budget &gt;$5k</span>
						</div>
					</div>
					<div class="yr-activity-row-duration">
						<span class="yr-activity-row-duration-label">Waiting</span>
						@LiveDuration("2026-10-11T08:00:00Z", &LiveDurationProps{})
					</div>
				}
			}
		}
		@TimelineGroup(&TimelineGroupProps{}) {
			<time datetime="2026-10-10">Yesterday</time>
			@TimelineEntries(&TimelineEntriesProps{}) {
				@ActivityRow(&ActivityRowProps{Href: "#"}) {
					<div>
						<div class="yr-activity-row-desc">Newsletter Digest</div>
						<div class="yr-activity-row-meta">
							<span class="yr-activity-row-id-badge">R-43</span>
							@Pill("Completed", &PillProps{Tone: "success", Shape: ShapePill})
							<span>2 outputs</span>
						</div>
					</div>
					<div class="yr-activity-row-duration">
						<span class="yr-activity-row-duration-label">58s</span>
					</div>
				}
				@ActivityRow(&ActivityRowProps{Href: "#", IsError: true}) {
					<div>
						<div class="yr-activity-row-desc">Social Scheduler</div>
						<div class="yr-activity-row-meta">
							<span class="yr-activity-row-id-badge">R-42</span>
							@Pill("Failed", &PillProps{Tone: "danger", Shape: ShapePill})
							<span>Rate limit exceeded</span>
						</div>
					</div>
					<div class="yr-activity-row-duration">
						<span class="yr-activity-row-duration-label">12s</span>
					</div>
				}
				@ActivityRow(&ActivityRowProps{Href: "#"}) {
					<div>
						<div class="yr-activity-row-desc">Lead Scoring</div>
						<div class="yr-activity-row-meta">
							<span class="yr-activity-row-id-badge">R-41</span>
							@Pill("Completed", &PillProps{Tone: "success", Shape: ShapePill})
							<span>1 output</span>
						</div>
					</div>
					<div class="yr-activity-row-duration">
						<span class="yr-activity-row-duration-label">4m 12s</span>
					</div>
				}
			}
		}
	</div>
}
