package ui

// WorkflowCardProps configures a WorkflowCard.
type WorkflowCardProps struct {
	Status      templ.Component
	Runs        string
	SuccessRate string
	Action      templ.Component
	Attrs       templ.Attributes
}

// WorkflowCard renders an installed workflow summary card.
func WorkflowCard(name, footerText string, p *WorkflowCardProps) templ.Component {
	return workflowCard(name, footerText, p)
}

templ workflowCard(name, footerText string, p *WorkflowCardProps) {
	<yr-workflow-card { filterAttrs("WorkflowCard", p.Attrs)... }>
		<div class="yr-workflow-card-header">
			<span class="yr-workflow-card-name">{ name }</span>
			if p.Status != nil {
				@p.Status
			}
		</div>
		<div class="yr-workflow-card-stats">
			@Stat(p.Runs, &StatProps{Label: "Runs"})
			@Stat(p.SuccessRate, &StatProps{Label: "Success"})
		</div>
		<div class="yr-workflow-card-footer">
			<span>{ footerText }</span>
			if p.Action != nil {
				@p.Action
			}
		</div>
	</yr-workflow-card>
}
