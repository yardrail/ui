package ui

const setupSlotStyle = `<style>.demo-slot{background:var(--yr-bg);` +
	`border:1px dashed var(--yr-border);` +
	`border-radius:var(--yr-radius-sm);` +
	`padding:var(--yr-space-1) var(--yr-space-3);` +
	`color:var(--yr-text-disabled);` +
	`font-family:var(--yr-font-mono);` +
	`font-size:var(--yr-font-size-xs)}</style>`

const setupOptionStyle = `<style>.setup-option{display:flex;align-items:center;` +
	`gap:var(--yr-space-3);padding:var(--yr-space-3)` +
	` var(--yr-space-4);border:1px solid var(--yr-border);` +
	`border-radius:var(--yr-radius-md);cursor:pointer;` +
	`font-family:var(--yr-font-ui);` +
	`font-size:var(--yr-font-size-sm);` +
	`color:var(--yr-text)}` +
	`.setup-option:hover{border-color:var(--yr-accent);` +
	`background:var(--yr-accent-subtle)}` +
	`.setup-option input{margin:0}` +
	`.setup-option-text{display:flex;flex-direction:column;` +
	`gap:var(--yr-space-1)}` +
	`.setup-option-label{font-weight:500}` +
	`.setup-option-desc{font-size:var(--yr-font-size-xs);` +
	`color:var(--yr-text-muted)}</style>`

templ setupCardDefault() {
	@templ.Raw(setupSlotStyle)
	@SetupCard(&SetupCardProps{}) {
		@SetupCardProgress(&SetupCardProgressProps{Steps: "4", Current: "1"})
		@SetupCardHeader(&SetupCardHeaderProps{}) {
			<div class="demo-slot">header</div>
		}
		@SetupCardBody(&SetupCardBodyProps{}) {
			<div class="demo-slot">body</div>
		}
		@SetupCardFooter(&SetupCardFooterProps{}) {
			<div class="demo-slot">footer</div>
		}
	}
}

templ setupCardFormStep() {
	@SetupCard(&SetupCardProps{}) {
		@SetupCardProgress(&SetupCardProgressProps{Steps: "4", Current: "1"})
		@SetupCardHeader(&SetupCardHeaderProps{}) {
			<h2 class="yr-setup-card-title">Create your organization</h2>
			<p class="yr-setup-card-subtitle">This is the workspace where your team will collaborate.</p>
		}
		@SetupCardBody(&SetupCardBodyProps{}) {
			@Field("Organization name", "sc-name", FieldProps{})
		}
		@SetupCardFooter(&SetupCardFooterProps{}) {
			<span></span>
			@Button("Continue", ButtonProps{Variant: ButtonPrimary, Type: ButtonSubmit})
		}
	}
}

templ setupCardSelectionStep() {
	@templ.Raw(setupOptionStyle)
	@SetupCard(&SetupCardProps{}) {
		@SetupCardProgress(&SetupCardProgressProps{Steps: "4", Current: "2"})
		@SetupCardHeader(&SetupCardHeaderProps{}) {
			<h2 class="yr-setup-card-title">Choose deployment type</h2>
			<p class="yr-setup-card-subtitle">Select how you want to run your instance.</p>
		}
		@SetupCardBody(&SetupCardBodyProps{}) {
			<label class="setup-option">
				<input type="radio" name="deploy" value="saas" checked/>
				<div class="setup-option-text">
					<span class="setup-option-label">Cloud (SaaS)</span>
					<span class="setup-option-desc">Managed hosting, automatic updates</span>
				</div>
			</label>
			<label class="setup-option">
				<input type="radio" name="deploy" value="self"/>
				<div class="setup-option-text">
					<span class="setup-option-label">Self-hosted</span>
					<span class="setup-option-desc">Run on your own infrastructure</span>
				</div>
			</label>
		}
		@SetupCardFooter(&SetupCardFooterProps{}) {
			<a class="yr-setup-card-back" href="#">Back</a>
			@Button("Continue", ButtonProps{Variant: ButtonPrimary})
		}
	}
}

templ setupCardConfirmation() {
	@SetupCard(&SetupCardProps{}) {
		@SetupCardProgress(&SetupCardProgressProps{Steps: "4", Current: "4"})
		@SetupCardHeader(&SetupCardHeaderProps{}) {
			<h2 class="yr-setup-card-title">You&#39;re all set</h2>
			<p class="yr-setup-card-subtitle">Your workspace is ready. You can invite teammates or start exploring on your own.</p>
		}
		@SetupCardBody(&SetupCardBodyProps{}) {
			@Alert(&AlertProps{Tone: "success"}) {
				Organization created successfully.
			}
		}
		@SetupCardFooter(&SetupCardFooterProps{}) {
			<span></span>
			@Button("Go to dashboard", ButtonProps{Variant: ButtonPrimary})
		}
	}
}
