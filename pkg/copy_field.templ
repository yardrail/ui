package ui

// CopyFieldProps configures a CopyField.
type CopyFieldProps struct {
	Attrs templ.Attributes
}

// CopyField renders a code display with a copy-to-clipboard button.
func CopyField(value string, p *CopyFieldProps) templ.Component {
	return copyField(value, p)
}

templ copyField(value string, p *CopyFieldProps) {
	<yr-copy-field { filterAttrs("CopyField", p.Attrs)... }>
		<code class="yr-copy-field-code">{ value }</code>
		<button type="button" class="yr-copy-field-button" data-value={ value }>Copy</button>
	</yr-copy-field>
}
