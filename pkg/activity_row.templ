package ui

// ActivityRowProps configures an ActivityRow.
type ActivityRowProps struct {
	Href    string
	IsError bool
	Attrs   templ.Attributes
}

// ActivityRow renders a run/activity entry. When Href is set it renders as a link;
// otherwise as a div. IsError adds the is-error modifier.
func ActivityRow(p *ActivityRowProps) templ.Component {
	return activityRow(p)
}

templ activityRow(p *ActivityRowProps) {
	if p.Href != "" {
		<a class={ "yr-activity-row", templ.KV("is-error", p.IsError) } href={ templ.SafeURL(p.Href) } { filterAttrs("ActivityRow", p.Attrs)... }>
			{ children... }
		</a>
	} else {
		<div class={ "yr-activity-row", templ.KV("is-error", p.IsError) } { filterAttrs("ActivityRow", p.Attrs)... }>
			{ children... }
		</div>
	}
}
