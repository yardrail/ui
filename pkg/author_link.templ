package ui

// AuthorLinkProps configures an AuthorLink.
type AuthorLinkProps struct {
	Href     string
	Handle   string
	Verified bool
	Avatar   string
	Size     string
	Heading  bool
	Attrs    templ.Attributes
}

// AuthorLink renders an author identity: avatar, name, handle, and verified badge.
func AuthorLink(name string, p *AuthorLinkProps) templ.Component {
	return authorLink(name, p)
}

templ authorLink(name string, p *AuthorLinkProps) {
	<yr-author-link { filterAttrs("AuthorLink", p.Attrs)... }>
		if p.Href != "" {
			<a class="yr-author-link-inner" href={ templ.SafeURL(p.Href) }>
				@authorLinkContent(name, p)
			</a>
		} else {
			<span class="yr-author-link-inner">
				@authorLinkContent(name, p)
			</span>
		}
	</yr-author-link>
}

templ authorLinkContent(name string, p *AuthorLinkProps) {
	if p.Avatar != "" {
		<yr-avatar size={ p.Size }>{ p.Avatar }</yr-avatar>
	}
	if p.Size == "lg" && name != "" && p.Handle != "" {
		<div class="yr-author-link-text">
			<div class="yr-author-link-name-row">
				if p.Heading {
					<h1 class="yr-author-link-name">{ name }</h1>
				} else {
					<strong class="yr-author-link-name">{ name }</strong>
				}
				if p.Verified {
					@authorLinkBadge()
				}
			</div>
			<p class="yr-author-link-handle">{ "@" + p.Handle }</p>
		</div>
	} else if name != "" {
		if p.Heading {
			<h1 class="yr-author-link-name">{ name }</h1>
		} else {
			<strong class="yr-author-link-name">{ name }</strong>
		}
		if p.Verified {
			@authorLinkBadge()
		}
	} else if p.Handle != "" {
		{ "@" + p.Handle }
	}
}

templ authorLinkBadge() {
	<span class="yr-author-link-badge" title="Verified author">
		@IconShield()
	</span>
}
