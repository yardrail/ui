package ui

// PillProps configures a Pill.
type PillProps struct {
	Tone  Tone
	Pill  bool
	Attrs templ.Attributes
}

// Pill renders a colored label.
func Pill(text string, p *PillProps) templ.Component {
	return pill(text, p)
}

templ pill(text string, p *PillProps) {
	<yr-pill
		tone={ p.Tone.String() }
		if p.Pill {
			shape="pill"
		}
		{ filterAttrs("Pill", p.Attrs)... }
	>{ text }</yr-pill>
}
