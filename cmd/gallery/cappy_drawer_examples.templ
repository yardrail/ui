package main

import ui "github.com/yardrail/ui/pkg"

templ chatAttachmentExample() {
	@ui.ChatAttachments() {
		@ui.ChatAttachment(ui.ChatAttachmentProps{
			Type: ui.AttachmentImage,
			Name: "error-screenshot.png",
			URL:  "/static/ui/cappy/wave.png",
		})
		@ui.ChatAttachment(ui.ChatAttachmentProps{
			Type: ui.AttachmentFile,
			Name: "connector-config.yaml",
			URL:  "#",
		})
	}
}

// cappyDrawerShell wraps content in a minimal workspace shell with a cappy drawer.
templ cappyDrawerShell(title string, drawer templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/ui/ui.css"/>
			<script type="module" src="/static/ui/ui.js"></script>
			<link rel="stylesheet" href="/mocks.css"/>
		</head>
		<body style="margin:0;height:100%">
			@ui.PageWorkspace(&ui.PageWorkspaceProps{}) {
				@ui.NavbarStd(&ui.NavbarStdProps{Logo: "/logo.png", Brand: "Yardrail", Authed: true}) {
					@ui.AccountMenu(&ui.AccountMenuProps{Name: "Brahm Lower", Email: "brahm@yardrail.com", Avatar: "BL"}) {
						<a class="yr-dropdown-menu-item" href="#">Account settings</a>
						<a class="yr-dropdown-menu-item" href="#">Sign out</a>
					}
				}
				@ui.Sidebar(&ui.SidebarProps{}) {
					@ui.SidebarHeader(&ui.SidebarHeaderProps{}) {
						<span style="font-family:var(--yr-font-body);font-weight:600;font-size:var(--yr-font-size-sm)">Yardrail</span>
					}
					@ui.SidebarNav(&ui.SidebarNavProps{}) {
						@ui.SidebarLink(&ui.SidebarLinkProps{Href: "#"}) {
							@ui.IconHome()
							Dashboard
						}
						@ui.SidebarLink(&ui.SidebarLinkProps{Href: "#", Active: true}) {
							@ui.IconZap()
							Automations
						}
					}
				}
				@ui.ResizeHandle(&ui.ResizeHandleProps{Target: "sidebar"})
				@ui.Content(&ui.ContentProps{}) {
					@ui.ContentMain(&ui.ContentMainProps{}) {
						{ children... }
					}
					@ui.ResizeHandle(&ui.ResizeHandleProps{Target: "drawer"})
					@drawer
				}
			}
		</body>
	</html>
}

// cappyDrawerDefault shows a simple conversation between the user and Cappy.
templ cappyDrawerDefault() {
	@cappyDrawerShell("Chat · Yardrail", cappyDrawerDefaultDrawer()) {
		<h1 class="portal-page-title">Automations</h1>
		<p>Your automations will appear here.</p>
	}
}

templ cappyDrawerDefaultDrawer() {
	@ui.CappyDrawer(ui.CappyDrawerProps{Open: true, Support: ui.SupportOnline}) {
		@ui.ChatMessage(ui.ChatMessageProps{
			Sender:    ui.ChatSenderCappy,
			Name:      "Cappy",
			Timestamp: "2:30 PM",
		}) {
			<p style="margin: 0;">Hi there! I'm Cappy. How can I help you today?</p>
		}
		@ui.ChatMessage(ui.ChatMessageProps{
			Sender:      ui.ChatSenderUser,
			Timestamp:   "2:31 PM",
			Attachments: chatAttachmentExample(),
		}) {
			<p style="margin: 0;">Here's the error I'm seeing and the config file.</p>
		}
		@ui.ChatMessage(ui.ChatMessageProps{
			Sender:    ui.ChatSenderCappy,
			Name:      "Cappy",
			Timestamp: "2:31 PM",
		}) {
			<p style="margin: 0;">I can see the issue — your connector config is missing the <strong>auth_token</strong> field. Let me help you fix that.</p>
		}
		@ui.ChatTyping(ui.ChatTypingProps{Sender: ui.ChatSenderCappy, Name: "Cappy"})
	}
}

// cappyDrawerToolCalls shows Cappy calling tools with allow/deny prompts.
templ cappyDrawerToolCalls() {
	@cappyDrawerShell("Debug · Yardrail", cappyDrawerToolCallsDrawer()) {
		<h1 class="portal-page-title">Workflow Run #42</h1>
		<p>Newsletter Digest — failed at step 3.</p>
	}
}

templ cappyDrawerToolCallsDrawer() {
	@ui.CappyDrawer(ui.CappyDrawerProps{Open: true, AutoApprove: true, Support: ui.SupportOnline, Variant: ui.CappyTrainEngineer}) {
		@ui.ChatMessage(ui.ChatMessageProps{
			Sender:    ui.ChatSenderUser,
			Timestamp: "3:15 PM",
		}) {
			<p style="margin: 0;">Why did my workflow run fail?</p>
		}
		@ui.ChatToolCalls(ui.ChatToolCallsProps{Count: 4, DoneCount: 4}) {
			@ui.ChatToolCall(ui.ChatToolCallProps{Name: "Read workflow run logs", Status: ui.ToolCallDone})
			@ui.ChatToolCall(ui.ChatToolCallProps{Name: "Read connector docs", Status: ui.ToolCallDone})
			@ui.ChatToolCall(ui.ChatToolCallProps{Name: "Check step 3 config", Status: ui.ToolCallDone})
			@ui.ChatToolCall(ui.ChatToolCallProps{Name: "Read rate limit policy", Status: ui.ToolCallDone})
		}
		@ui.ChatMessage(ui.ChatMessageProps{
			Sender:    ui.ChatSenderCappy,
			Name:      "Cappy",
			Timestamp: "3:16 PM",
		}) {
			<p style="margin: 0;">The run failed at step 3 because the API rate limit was exceeded. I can increase the retry count to 5 — that should handle transient rate limits.</p>
		}
		@ui.ChatTyping(ui.ChatTypingProps{Sender: ui.ChatSenderCappy, Name: "Cappy", Working: true})
	}
}

// cappyDrawerEscalated shows a three-way conversation after support joins.
templ cappyDrawerEscalated() {
	@cappyDrawerShell("Support · Yardrail", cappyDrawerEscalatedDrawer()) {
		<h1 class="portal-page-title">Settings</h1>
		<p>Manage your account and billing.</p>
	}
}

templ cappyDrawerEscalatedDrawer() {
	@ui.CappyDrawer(ui.CappyDrawerProps{Open: true, Placeholder: "Message…", SupportName: "Sarah", SupportAvatarURL: "/static/ui/cappy/support-placeholder.svg"}) {
		@ui.ChatMessage(ui.ChatMessageProps{
			Sender:    ui.ChatSenderUser,
			Timestamp: "4:00 PM",
		}) {
			<p style="margin: 0;">I need help with a billing question.</p>
		}
		@ui.ChatMessage(ui.ChatMessageProps{
			Sender:    ui.ChatSenderCappy,
			Name:      "Cappy",
			Timestamp: "4:00 PM",
		}) {
			<p style="margin: 0;">I've brought in Sarah from support — she can see our conversation so far.</p>
		}
		@ui.ChatJoin(ui.ChatJoinProps{Name: "Sarah from support"})
		@ui.ChatMessage(ui.ChatMessageProps{
			Sender:    ui.ChatSenderHuman,
			Name:      "Sarah",
			AvatarURL: "",
			Timestamp: "4:01 PM",
		}) {
			<p style="margin: 0;">Hi! I can help with billing. What's your question?</p>
		}
		@ui.ChatMessage(ui.ChatMessageProps{
			Sender:    ui.ChatSenderUser,
			Timestamp: "4:02 PM",
		}) {
			<p style="margin: 0;">Can I switch to annual billing?</p>
		}
		@ui.ChatTyping(ui.ChatTypingProps{Sender: ui.ChatSenderHuman, Name: "Sarah"})
	}
}
