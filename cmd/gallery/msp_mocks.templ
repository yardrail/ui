package main

import ui "github.com/yardrail/ui/pkg"

// Nav links of the MSP portal mocks, naming the active one.
const (
	mspNavDashboard = "dashboard"
	mspNavClients   = "clients"
	mspNavYardrail  = "yardrail"
	mspNavAccount   = "account"
)

// mspHead links the mock stylesheet, served by the gallery at /mocks.css.
templ mspHead() {
	<link rel="stylesheet" href="/mocks.css"/>
}

// mspShell is the page frame shared by the MSP portal mocks: a navbar, sidebar navigation,
// and the children in the content area.
templ mspShell(title string, nav templ.Component) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/ui/ui.css"/>
			<script type="module" src="/static/ui/ui.js"></script>
			@mspHead()
		</head>
		<body style="margin:0;height:100%">
			@ui.PageWorkspace(&ui.PageWorkspaceProps{}) {
				@ui.NavbarStd(&ui.NavbarStdProps{Logo: "/logo.png", Brand: "Yardrail", Authed: true}) {
					@ui.AccountMenu(&ui.AccountMenuProps{Name: "Brahm Lower", Email: "brahm@yardrail.com", Avatar: "BL"}) {
						<a class="yr-dropdown-menu-item" href="#">Account settings</a>
						<a class="yr-dropdown-menu-item" href="#">Sign out</a>
					}
				}
				@nav
				@ui.ResizeHandle(&ui.ResizeHandleProps{Target: "sidebar"})
				@ui.Content(&ui.ContentProps{}) {
					@ui.ContentMain(&ui.ContentMainProps{}) {
						{ children... }
					}
				}
			}
		</body>
	</html>
}

// mspNav is the MSP portal sidebar with the link named active highlighted.
// The children, such as a client's org and sub-links, go between the top and bottom nav groups.
templ mspNav(active string) {
	@ui.Sidebar(&ui.SidebarProps{}) {
		@ui.SidebarHeader(&ui.SidebarHeaderProps{}) {
			<span style="font-family:var(--yr-font-body);font-weight:600;font-size:var(--yr-font-size-sm)">MSP Portal</span>
		}
		@ui.SidebarNav(&ui.SidebarNavProps{}) {
			@mspNavLink(ui.IconLayoutDashboard(), "Dashboard", mspNavDashboard, active)
			@mspNavLink(ui.IconBuilding2(), "Clients", mspNavClients, active)
		}
		{ children... }
		@ui.SidebarNav(&ui.SidebarNavProps{Bottom: true}) {
			@mspNavLink(ui.IconTrainFront(), "Yardrail", mspNavYardrail, active)
			@mspNavLink(ui.IconUser(), "Account", mspNavAccount, active)
		}
		@ui.SidebarFooter(&ui.SidebarFooterProps{}) {
			<span style="font-size:var(--yr-font-size-xs);color:var(--yr-text-subtle)">v0.1.0</span>
		}
	}
}

// mspNavLink is one link in the MSP sidebar, highlighted when link equals active.
templ mspNavLink(icon templ.Component, label, link, active string) {
	@ui.SidebarLink(&ui.SidebarLinkProps{Href: "#", Active: link == active}) {
		@icon
		{ label }
	}
}

// mspPageTitle is the h1 of an MSP portal mock.
templ mspPageTitle(title string) {
	<h1 class="mock-page-title">{ title }</h1>
}

// mspSection is a titled section of an MSP portal mock, holding a feed of the children.
templ mspSection(title string) {
	@ui.Stack(ui.StackProps{Gap: ui.Space3}) {
		<p class="mock-section-title">{ title }</p>
		@ui.Stack(ui.StackProps{Gap: ui.Space2}) {
			{ children... }
		}
	}
}

// mspStatCard is a stat card showing value over label, with an optional tone modifier on its
// left border ("success", "warning" or "danger").
templ mspStatCard(value, label, tone string) {
	<div class={ "mock-stat-card", templ.KV("mock-stat-card--"+tone, tone != "") }>
		@ui.Stack(ui.StackProps{Gap: ui.Space1}) {
			<p class="mock-stat-value">{ value }</p>
			<p class="mock-stat-label">{ label }</p>
		}
	</div>
}

// mspCredentialStat is one figure of the credential health card, with an optional tone colour
// ("warning" or "danger").
templ mspCredentialStat(value, label, tone string) {
	@ui.Stack(ui.StackProps{Gap: ui.Space1}) {
		<p class={ "mock-stat-value", "mock-stat-value--compact", templ.KV("mock-stat-value--"+tone, tone != "") }>{ value }</p>
		<p class="mock-stat-label">{ label }</p>
	}
}

// mspFeedItem is one row of a feed: the children, then time at the far end when it is set.
templ mspFeedItem(time string) {
	<div class="mock-feed-item">
		@ui.Cluster(ui.ClusterProps{Justify: ui.JustifyBetween, Gap: ui.Space3}) {
			@ui.Cluster(ui.ClusterProps{Gap: ui.Space3}) {
				{ children... }
			}
			if time != "" {
				<span class="mock-feed-time">{ time }</span>
			}
		}
	</div>
}

// mspClientRow is one client in a list: the children at the start, meta at the far end when it
// is set.
templ mspClientRow(meta string) {
	<div class="mock-client-row">
		@ui.Cluster(ui.ClusterProps{Justify: ui.JustifyBetween, Gap: ui.Space4}) {
			@ui.Cluster(ui.ClusterProps{Gap: ui.Space4}) {
				{ children... }
			}
			if meta != "" {
				<span class="mock-client-meta">{ meta }</span>
			}
		}
	</div>
}

// mspDashboard is the MSP portal dashboard mock.
templ mspDashboard() {
	@mspShell("Dashboard · MSP Portal", mspNav(mspNavDashboard)) {
		@ui.Stack(ui.StackProps{Gap: ui.Space8}) {
			@mspPageTitle("Dashboard")
			@ui.Grid(ui.GridProps{MinItemWidth: ui.ItemWidthSm}) {
				@mspStatCard("12", "Total Clients", "")
				@mspStatCard("9", "Healthy", "success")
				@mspStatCard("2", "Needs Attention", "warning")
				@mspStatCard("1", "Critical", "danger")
			}
			@ui.Grid(ui.GridProps{Gap: ui.Space8}) {
				@mspSection("Alerts") {
					@mspFeedItem("2m ago") {
						@ui.Pill("critical", &ui.PillProps{Tone: "danger"})
						<span>Workflow failed — Acme Corp</span>
					}
					@mspFeedItem("18m ago") {
						@ui.Pill("warning", &ui.PillProps{Tone: "warning"})
						<span>Connector unhealthy — Beta LLC</span>
					}
					@mspFeedItem("1h ago") {
						@ui.Pill("warning", &ui.PillProps{Tone: "warning"})
						<span>API key expires in 7d — Gamma Inc</span>
					}
					@mspFeedItem("3h ago") {
						@ui.Pill("info", &ui.PillProps{Tone: "info"})
						<span>New user joined — Delta Co</span>
					}
				}
				@mspSection("Credential Health") {
					<div class="mock-stat-card">
						@ui.Cluster(ui.ClusterProps{Justify: ui.JustifyBetween}) {
							@mspCredentialStat("42", "Healthy", "")
							@mspCredentialStat("3", "Expiring <30d", "warning")
							@mspCredentialStat("1", "Expired", "danger")
						}
					</div>
					@mspFeedItem("") {
						@ui.Pill("expired", &ui.PillProps{Tone: "danger"})
						<span>Slack OAuth — Acme Corp</span>
					}
					@mspFeedItem("") {
						@ui.Pill("14d", &ui.PillProps{Tone: "warning"})
						<span>HubSpot API — Beta LLC</span>
					}
					@mspFeedItem("") {
						@ui.Pill("22d", &ui.PillProps{Tone: "warning"})
						<span>Stripe key — Gamma Inc</span>
					}
				}
			}
			@ui.Grid(ui.GridProps{Gap: ui.Space8}) {
				@mspSection("Recent Activity") {
					@mspFeedItem("10m ago") {
						@ui.IconUserPlus()
						<span>User invited to Acme Corp</span>
					}
					@mspFeedItem("45m ago") {
						@ui.IconPlay()
						<span>Workflow deployed to Beta LLC</span>
					}
					@mspFeedItem("2h ago") {
						@ui.IconRefreshCw()
						<span>Credential rotated — Gamma Inc</span>
					}
					@mspFeedItem("5h ago") {
						@ui.IconShield()
						<span>2FA enforced on Delta Co</span>
					}
				}
				@mspSection("Onboarding Progress") {
					@mspClientRow("") {
						<span class="mock-client-name">NewCo Industries</span>
						@ui.Pill("2 of 4 steps", &ui.PillProps{})
					}
					@mspClientRow("") {
						<span class="mock-client-name">FreshOrg Ltd</span>
						@ui.Pill("Users invited", &ui.PillProps{})
					}
				}
			}
		}
	}
}

// mspClients is the MSP portal client list mock.
templ mspClients() {
	@mspShell("Clients · MSP Portal", mspNav(mspNavClients)) {
		@ui.Stack(ui.StackProps{Gap: ui.Space6}) {
			@ui.Cluster(ui.ClusterProps{Justify: ui.JustifyBetween}) {
				@mspPageTitle("Clients")
				@ui.Button("Add Client", ui.ButtonProps{Variant: ui.ButtonPrimary})
			}
			@ui.Stack(ui.StackProps{Gap: ui.Space2}) {
				@mspClientRow("8 users · 3 connectors · 12 workflows") {
					@ui.Pill("healthy", &ui.PillProps{Tone: "success"})
					<span class="mock-client-name">Acme Corp</span>
				}
				@mspClientRow("4 users · 2 connectors · 6 workflows") {
					@ui.Pill("healthy", &ui.PillProps{Tone: "success"})
					<span class="mock-client-name">Beta LLC</span>
				}
				@mspClientRow("12 users · 5 connectors · 18 workflows") {
					@ui.Pill("attention", &ui.PillProps{Tone: "warning"})
					<span class="mock-client-name">Gamma Inc</span>
				}
				@mspClientRow("3 users · 1 connector · 4 workflows") {
					@ui.Pill("healthy", &ui.PillProps{Tone: "success"})
					<span class="mock-client-name">Delta Co</span>
				}
				@mspClientRow("6 users · 4 connectors · 9 workflows") {
					@ui.Pill("critical", &ui.PillProps{Tone: "danger"})
					<span class="mock-client-name">Epsilon Group</span>
				}
				@mspClientRow("5 users · 2 connectors · 7 workflows") {
					@ui.Pill("healthy", &ui.PillProps{Tone: "success"})
					<span class="mock-client-name">Zeta Partners</span>
				}
			}
		}
	}
}

// Client pages of the MSP portal mocks, naming the active one in the client nav.
const (
	mspClientOverview   = "overview"
	mspClientUsers      = "users"
	mspClientConnectors = "connectors"
	mspClientWorkflows  = "workflows"
	mspClientSettings   = "settings"
)

// mspClientNav is the MSP portal sidebar for a client's pages: the portal links, then the
// client's org block and its links, with the page named active highlighted.
templ mspClientNav(active string) {
	@mspNav("") {
		@ui.SidebarOrg(&ui.SidebarOrgProps{Name: "Acme Corp", Initial: "A"})
		@ui.SidebarNav(&ui.SidebarNavProps{}) {
			@mspNavLink(ui.IconLayoutDashboard(), "Overview", mspClientOverview, active)
			@mspNavLink(ui.IconUsers(), "Users", mspClientUsers, active)
			@mspNavLink(ui.IconPlug(), "Connectors", mspClientConnectors, active)
			@mspNavLink(ui.IconPlay(), "Workflows", mspClientWorkflows, active)
			@mspNavLink(ui.IconSettings(), "Settings", mspClientSettings, active)
		}
	}
}

// mspPageHeader is the h1 of an MSP portal mock with the children, such as a primary action, at
// the far end.
templ mspPageHeader(title string) {
	@ui.Cluster(ui.ClusterProps{Justify: ui.JustifyBetween}) {
		@mspPageTitle(title)
		{ children... }
	}
}

// mspSetting is a card naming a setting over its description, with the children, such as its
// status, at the far end.
templ mspSetting(name, description string) {
	<div class="mock-stat-card">
		@ui.Cluster(ui.ClusterProps{Justify: ui.JustifyBetween}) {
			@ui.Stack(ui.StackProps{Gap: ui.Space1}) {
				<p class="mock-setting-name">{ name }</p>
				<p class="mock-stat-label">{ description }</p>
			}
			{ children... }
		}
	</div>
}

// mspPolicy is one figure of a policy card: the value under its label.
templ mspPolicy(label, value string) {
	@ui.Stack(ui.StackProps{Gap: ui.Space1}) {
		<p class="mock-stat-label">{ label }</p>
		<p class="mock-setting-name">{ value }</p>
	}
}

// mspConnectorRow is one connector in a list: its icon, name and meta, with the children, such as
// its health, at the far end.
templ mspConnectorRow(icon templ.Component, name, meta string) {
	<div class="mock-client-row">
		@ui.Cluster(ui.ClusterProps{Justify: ui.JustifyBetween, Gap: ui.Space4}) {
			@ui.Cluster(ui.ClusterProps{Gap: ui.Space3}) {
				@icon
				@ui.Stack(ui.StackProps{Gap: ui.Space1}) {
					<span class="mock-client-name">{ name }</span>
					<span class="mock-client-meta">{ meta }</span>
				}
			}
			{ children... }
		}
	</div>
}

// mspClientOverviewPage is the MSP portal mock of a client's overview.
templ mspClientOverviewPage() {
	@mspShell("Acme Corp · MSP Portal", mspClientNav(mspClientOverview)) {
		@ui.Stack(ui.StackProps{Gap: ui.Space8}) {
			@mspPageTitle("Acme Corp")
			@ui.Grid(ui.GridProps{MinItemWidth: ui.ItemWidthSm}) {
				@mspStatCard("8", "Users", "")
				@mspStatCard("3", "Connectors", "")
				@mspStatCard("12", "Workflows", "")
			}
			@ui.Grid(ui.GridProps{Gap: ui.Space8}) {
				@mspSection("Recent Activity") {
					@mspFeedItem("2h ago") {
						@ui.IconUserPlus()
						<span>Jane Smith invited</span>
					}
					@mspFeedItem("1d ago") {
						@ui.IconPlay()
						<span>Invoice sync deployed</span>
					}
					@mspFeedItem("3d ago") {
						@ui.IconRefreshCw()
						<span>Slack credential rotated</span>
					}
				}
				@mspSection("Alerts") {
					@mspFeedItem("2m ago") {
						@ui.Pill("critical", &ui.PillProps{Tone: "danger"})
						<span>Slack OAuth expired</span>
					}
					@mspFeedItem("1h ago") {
						@ui.Pill("info", &ui.PillProps{Tone: "info"})
						<span>2 workflows paused</span>
					}
				}
			}
		}
	}
}

// mspClientUsersPage is the MSP portal mock of a client's users.
templ mspClientUsersPage() {
	@mspShell("Acme Corp — Users · MSP Portal", mspClientNav(mspClientUsers)) {
		@ui.Stack(ui.StackProps{Gap: ui.Space8}) {
			@ui.Stack(ui.StackProps{Gap: ui.Space6}) {
				@mspPageHeader("Acme Corp — Users") {
					@ui.Button("Invite User", ui.ButtonProps{Variant: ui.ButtonPrimary})
				}
				<table class="yr-table">
					<thead>
						<tr><th>Name</th><th>Email</th><th>Role</th><th>Spaces</th><th>Status</th></tr>
					</thead>
					<tbody>
						<tr>
							<td>Alex Johnson</td>
							<td>alex@acme.com</td>
							<td>@ui.Pill("Admin", &ui.PillProps{})</td>
							<td>All spaces</td>
							<td>@ui.Pill("Active", &ui.PillProps{Tone: "success"})</td>
						</tr>
						<tr>
							<td>Maria Chen</td>
							<td>maria@acme.com</td>
							<td>@ui.Pill("Editor", &ui.PillProps{})</td>
							<td>Sales, Support</td>
							<td>@ui.Pill("Active", &ui.PillProps{Tone: "success"})</td>
						</tr>
						<tr>
							<td>Sam Patel</td>
							<td>sam@acme.com</td>
							<td>@ui.Pill("Viewer", &ui.PillProps{})</td>
							<td>Sales</td>
							<td>@ui.Pill("Active", &ui.PillProps{Tone: "success"})</td>
						</tr>
						<tr>
							<td>Taylor Kim</td>
							<td>taylor@acme.com</td>
							<td>@ui.Pill("Editor", &ui.PillProps{})</td>
							<td>Ops, Finance</td>
							<td>@ui.Pill("Invited", &ui.PillProps{})</td>
						</tr>
					</tbody>
				</table>
			}
			@mspSection("SCIM Sync") {
				@mspSetting("Azure AD", "Last synced 4 hours ago · 8 users") {
					@ui.Pill("Connected", &ui.PillProps{Tone: "success"})
				}
			}
		}
	}
}

// mspClientConnectorsPage is the MSP portal mock of a client's connectors.
templ mspClientConnectorsPage() {
	@mspShell("Acme Corp — Connectors · MSP Portal", mspClientNav(mspClientConnectors)) {
		@ui.Stack(ui.StackProps{Gap: ui.Space6}) {
			@mspPageHeader("Acme Corp — Connectors") {
				@ui.Button("Add Connector", ui.ButtonProps{Variant: ui.ButtonPrimary})
			}
			@ui.Stack(ui.StackProps{Gap: ui.Space2}) {
				@mspConnectorRow(ui.IconMessageSquare(), "Slack", "OAuth · Used by 4 workflows") {
					@ui.Pill("Expired", &ui.PillProps{Tone: "danger"})
				}
				@mspConnectorRow(ui.IconDatabase(), "HubSpot", "API Key · Used by 6 workflows") {
					@ui.Pill("Healthy", &ui.PillProps{Tone: "success"})
				}
				@mspConnectorRow(ui.IconCreditCard(), "Stripe", "API Key · Used by 2 workflows") {
					@ui.Pill("Healthy", &ui.PillProps{Tone: "success"})
				}
			}
		}
	}
}

// mspClientSettingsPage is the MSP portal mock of a client's settings.
templ mspClientSettingsPage() {
	@mspShell("Acme Corp — Settings · MSP Portal", mspClientNav(mspClientSettings)) {
		@ui.Stack(ui.StackProps{Gap: ui.Space8}) {
			@mspPageTitle("Acme Corp — Settings")
			@mspSection("Authentication") {
				@mspSetting("Two-Factor Authentication", "Require 2FA for all users in this organization") {
					@ui.Pill("Required", &ui.PillProps{Tone: "success"})
				}
				@mspSetting("Single Sign-On", "SAML/OIDC integration with client identity provider") {
					@ui.Pill("Not configured", &ui.PillProps{})
				}
			}
			@mspSection("Session Policies") {
				<div class="mock-stat-card">
					@ui.Cluster(ui.ClusterProps{Gap: ui.Space8}) {
						@mspPolicy("Idle Timeout", "30 minutes")
						@mspPolicy("Max Session", "8 hours")
						@mspPolicy("IP Allowlist", "Disabled")
					}
				</div>
			}
		}
	}
}
