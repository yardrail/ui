package main

import ui "github.com/yardrail/ui/pkg"

templ settingsSectionAvatarRow() {
	@ui.SettingsSection(&ui.SettingsSectionProps{}) {
		<h2>Profile photo</h2>
		<p class="yr-settings-section-success">Your photo has been updated.</p>
		<div class="yr-settings-section-avatar-row">
			@ui.Avatar("BL", &ui.AvatarProps{Large: true})
			<form method="post" action="#" enctype="multipart/form-data">
				<input type="file" name="avatar" accept="image/png,image/jpeg" required/>
				@ui.Button("Upload", ui.ButtonProps{Variant: ui.ButtonPrimary, Type: ui.ButtonSubmit})
			</form>
		</div>
	}
}

templ settingsSectionFieldRow() {
	@ui.SettingsSection(&ui.SettingsSectionProps{}) {
		<h2>Display name</h2>
		@ui.Form(ui.FormProps{}) {
			@ui.Field("Display name", "settings-display-name", ui.FieldProps{Value: "Blake Lindqvist"})
			<div>
				@ui.Button("Save", ui.ButtonProps{Variant: ui.ButtonPrimary, Type: ui.ButtonSubmit})
			</div>
		}
	}
}
