package main

import ui "github.com/yardrail/ui/pkg"

templ ratingValuesExample() {
	<div style="display:flex;flex-direction:column;gap:0.75rem">
		@ui.Rating("5", &ui.RatingProps{Reviews: "128"})
		@ui.Rating("4.5", &ui.RatingProps{Reviews: "42"})
		@ui.Rating("3", &ui.RatingProps{})
		@ui.Rating("1", &ui.RatingProps{})
	</div>
}
