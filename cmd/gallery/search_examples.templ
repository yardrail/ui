package main

templ searchExamplePlain() {
	<form class="yr-search" method="get" action="#" role="search">
		@templ.Raw(exampleIcon("search", `class="yr-search-icon"`, searchIconSize))
		<input class="yr-search-input" type="search" name="q" placeholder="Search templates…" autocomplete="off"/>
	</form>
}

templ searchExampleHero() {
	<form class="yr-search yr-search--hero" method="get" action="#" role="search">
		@templ.Raw(exampleIcon("search", `class="yr-search-icon"`, searchHeroIconSize))
		<input class="yr-search-input" type="search" name="q" placeholder="Search 500+ templates…" autocomplete="off"/>
	</form>
}

templ searchExampleCompact() {
	<form class="yr-search yr-search--compact" method="get" action="#" role="search">
		@templ.Raw(exampleIcon("search", `class="yr-search-icon"`, searchCompactIconSize))
		<input class="yr-search-input" type="search" name="q" placeholder="Search connectors…" autocomplete="off"/>
	</form>
}
