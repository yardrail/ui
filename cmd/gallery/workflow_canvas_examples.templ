package main

import ui "github.com/yardrail/ui/pkg"

templ workflowCanvasDefault() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Workflow Builder · Yardrail</title>
			<link rel="stylesheet" href="/static/ui/ui.css"/>
			<script type="module" src="/static/ui/ui.js"></script>
			<link rel="stylesheet" href="/mocks.css"/>
		</head>
		<body style="margin:0;height:100%">
			@ui.PageWorkspace(&ui.PageWorkspaceProps{}) {
				@ui.NavbarStd(&ui.NavbarStdProps{Logo: "/logo.png", Brand: "Yardrail", Authed: true}) {
					@ui.AccountMenu(&ui.AccountMenuProps{Name: "Brahm Lower", Email: "brahm@yardrail.com", Avatar: "BL"}) {
						<a class="yr-dropdown-menu-item" href="#">Account settings</a>
						<a class="yr-dropdown-menu-item" href="#">Sign out</a>
					}
				}
				@ui.Sidebar(&ui.SidebarProps{}) {
					@ui.SidebarHeader(&ui.SidebarHeaderProps{}) {
						<span style="font-family:var(--yr-font-body);font-weight:600;font-size:var(--yr-font-size-sm)">Yardrail</span>
					}
					@ui.SidebarNav(&ui.SidebarNavProps{}) {
						@ui.SidebarLink(&ui.SidebarLinkProps{Href: "#"}) {
							@ui.IconHome()
							Dashboard
						}
						@ui.SidebarLink(&ui.SidebarLinkProps{Href: "#", Active: true}) {
							@ui.IconZap()
							Automations
						}
					}
				}
				@ui.ResizeHandle(&ui.ResizeHandleProps{Target: "sidebar"})
				@ui.Content(&ui.ContentProps{}) {
					@ui.ContentMain(&ui.ContentMainProps{}) {
						@ui.WorkflowCanvas(ui.WorkflowCanvasProps{})
					}
				}
			}
		</body>
	</html>
}
