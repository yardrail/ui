package main

import ui "github.com/yardrail/ui/pkg"

templ pillTonesExample() {
	<div style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center">
		@ui.Pill("Accent", &ui.PillProps{Tone: ui.ToneAccent})
		@ui.Pill("Amber", &ui.PillProps{Tone: ui.ToneAmber})
		@ui.Pill("Blue", &ui.PillProps{Tone: ui.ToneBlue})
		@ui.Pill("Green", &ui.PillProps{Tone: ui.ToneGreen})
		@ui.Pill("Purple", &ui.PillProps{Tone: ui.TonePurple})
		@ui.Pill("Pink", &ui.PillProps{Tone: ui.TonePink})
		@ui.Pill("Danger", &ui.PillProps{Tone: ui.ToneDanger})
		@ui.Pill("No tone", &ui.PillProps{})
	</div>
}

templ pillStatusExample() {
	<div style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center">
		@ui.Pill("Running", &ui.PillProps{Tone: ui.ToneSuccess, Pill: true})
		@ui.Pill("Deploying", &ui.PillProps{Tone: ui.ToneWarning, Pill: true})
		@ui.Pill("Failed", &ui.PillProps{Tone: ui.ToneDanger, Pill: true})
		@ui.Pill("Idle", &ui.PillProps{Pill: true})
	</div>
}

templ pillInteractiveExample() {
	<div style="display:flex;flex-wrap:wrap;gap:0.5rem">
		<a href="#" class="yr-pill yr-pill--pill yr-pill--tone-accent is-active">All</a>
		<a href="#" class="yr-pill yr-pill--pill">Marketing</a>
		<a href="#" class="yr-pill yr-pill--pill">Analytics</a>
		<a href="#" class="yr-pill yr-pill--pill">Sales</a>
	</div>
}
