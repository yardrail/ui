package main

import ui "github.com/yardrail/ui/pkg"

templ pillTonesExample() {
	<div style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center">
		@ui.Pill("Accent", &ui.PillProps{Tone: "accent"})
		@ui.Pill("Amber", &ui.PillProps{Tone: "amber"})
		@ui.Pill("Blue", &ui.PillProps{Tone: "blue"})
		@ui.Pill("Green", &ui.PillProps{Tone: "green"})
		@ui.Pill("Purple", &ui.PillProps{Tone: "purple"})
		@ui.Pill("Pink", &ui.PillProps{Tone: "pink"})
		@ui.Pill("Danger", &ui.PillProps{Tone: "danger"})
		@ui.Pill("No tone", &ui.PillProps{})
	</div>
}

templ pillStatusExample() {
	<div style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center">
		@ui.Pill("Running", &ui.PillProps{Tone: "success", Shape: ui.ShapePill})
		@ui.Pill("Deploying", &ui.PillProps{Tone: "warning", Shape: ui.ShapePill})
		@ui.Pill("Failed", &ui.PillProps{Tone: "danger", Shape: ui.ShapePill})
		@ui.Pill("Idle", &ui.PillProps{Shape: ui.ShapePill})
	</div>
}

templ pillInteractiveExample() {
	<div style="display:flex;flex-wrap:wrap;gap:0.5rem">
		<a href="#" class="yr-pill yr-pill--pill yr-pill--tone-accent is-active">All</a>
		<a href="#" class="yr-pill yr-pill--pill">Marketing</a>
		<a href="#" class="yr-pill yr-pill--pill">Analytics</a>
		<a href="#" class="yr-pill yr-pill--pill">Sales</a>
	</div>
}
