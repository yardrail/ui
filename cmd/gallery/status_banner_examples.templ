package main

import ui "github.com/yardrail/ui/pkg"

templ statusBannerActiveExample() {
	<div style="max-width:44rem">
		@ui.StatusBanner(&ui.StatusBannerProps{Tone: ui.ToneSuccess}) {
			@ui.Pill("Active", &ui.PillProps{Tone: ui.ToneSuccess, Pill: true})
			<span class="yr-status-banner-message">Workflow is running. Last triggered 2h ago.</span>
			<div class="yr-status-banner-actions">
				@ui.Button("Pause", ui.ButtonProps{Variant: ui.ButtonSecondary})
			</div>
		}
	</div>
}

templ statusBannerPausedExample() {
	<div style="max-width:44rem">
		@ui.StatusBanner(&ui.StatusBannerProps{Tone: ui.ToneWarning}) {
			@ui.Pill("Paused", &ui.PillProps{Tone: ui.ToneWarning, Pill: true})
			<span class="yr-status-banner-message">Workflow is paused. No runs will be triggered.</span>
			<div class="yr-status-banner-actions">
				@ui.Button("Resume", ui.ButtonProps{Variant: ui.ButtonSecondary})
			</div>
		}
	</div>
}

templ statusBannerFailedExample() {
	<div style="max-width:44rem">
		@ui.StatusBanner(&ui.StatusBannerProps{Tone: ui.ToneDanger}) {
			@ui.Pill("Failed", &ui.PillProps{Tone: ui.ToneDanger, Pill: true})
			<span class="yr-status-banner-message">Last run failed: connector returned 401.</span>
			<div class="yr-status-banner-actions">
				@ui.Button("Retry", ui.ButtonProps{Variant: ui.ButtonSecondary})
			</div>
		}
	</div>
}
