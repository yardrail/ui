package main

import ui "github.com/yardrail/ui/pkg"

templ drawerExampleDefault() {
	<style>
		.demo-slot {
			background: var(--yr-bg);
			border: 1px dashed var(--yr-border);
			border-radius: var(--yr-radius-sm);
			padding: var(--yr-space-1) var(--yr-space-3);
			color: var(--yr-text-disabled);
			font-family: var(--yr-font-mono);
			font-size: var(--yr-font-size-xs);
		}
	</style>
	<yr-drawer open style="height:100vh">
		<yr-drawer-header>
			<div class="demo-slot">title</div>
			<yr-drawer-close>
				@ui.IconX()
			</yr-drawer-close>
		</yr-drawer-header>
		<yr-drawer-body>
			<div class="demo-slot">body</div>
		</yr-drawer-body>
	</yr-drawer>
}

templ drawerExampleWithContent() {
	<yr-drawer open style="height:100vh">
		<yr-drawer-header>
			<h3 class="yr-drawer-title">Details</h3>
			<yr-drawer-close>
				@ui.IconX()
			</yr-drawer-close>
		</yr-drawer-header>
		<yr-drawer-body>
			<p style="font-size:var(--yr-font-size-sm);color:var(--yr-text-muted);margin:0 0 var(--yr-space-4)">Drawer content goes here.</p>
			@ui.Card(&ui.CardProps{}) {
				<div class="yr-card-title">Status</div>
				@ui.Pill("Active", &ui.PillProps{Tone: ui.ToneSuccess})
			}
		</yr-drawer-body>
	</yr-drawer>
}

templ drawerExampleWithForm() {
	<yr-drawer open style="height:100vh">
		<yr-drawer-header>
			<h3 class="yr-drawer-title">Edit Session</h3>
			<yr-drawer-close>
				@ui.IconX()
			</yr-drawer-close>
		</yr-drawer-header>
		<yr-drawer-body>
			<div class="yr-field" style="margin-bottom:var(--yr-space-4)">
				<label class="yr-field-label">Name</label>
				<input class="yr-field-input" type="text" value="Weekly Review"/>
			</div>
			<div class="yr-field" style="margin-bottom:var(--yr-space-4)">
				<label class="yr-field-label">Description</label>
				<textarea class="yr-field-input" rows="3">Automated weekly report generation</textarea>
			</div>
			@ui.Button("Save", ui.ButtonProps{Variant: ui.ButtonPrimary})
		</yr-drawer-body>
	</yr-drawer>
}
