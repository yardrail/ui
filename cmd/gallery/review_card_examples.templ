package main

import ui "github.com/yardrail/ui/pkg"

templ reviewCardReviews() {
	<div style="display:flex;flex-direction:column;gap:0.75rem;max-width:36rem">
		@ui.ReviewCard(&ui.ReviewCardProps{}) {
			<div class="yr-review-card-header">
				@ui.Rating("5", &ui.RatingProps{})
				<span class="yr-review-card-author">Jordan Ellery</span>
			</div>
			<p class="yr-review-card-body">Set up in ten minutes and it has run every night since. The documentation covers the two connector scopes you need.</p>
		}
		@ui.ReviewCard(&ui.ReviewCardProps{}) {
			<div class="yr-review-card-header">
				@ui.Rating("3", &ui.RatingProps{})
				<span class="yr-review-card-author">Sam Okafor</span>
			</div>
			<p class="yr-review-card-body">Works, but the Slack step needs a manual channel ID.</p>
		}
	</div>
}
