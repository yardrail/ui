package main

import ui "github.com/yardrail/ui/pkg"

templ navShellExampleTopNav() {
	@ui.NavShell(&ui.NavShellProps{
		Left:   navShellExampleBrand(),
		Center: navShellExampleSearch(),
	}) {
		<a href="#" style="font-family:var(--yr-font-ui);font-size:var(--yr-font-size-sm);color:var(--yr-text-muted);text-decoration:none">Docs</a>
		@ui.Avatar("BL", &ui.AvatarProps{})
	}
}

templ navShellExampleBrand() {
	<a href="#" class="yr-brand">Yardrail</a>
}

templ navShellExampleSearch() {
	<div class="yr-search">
		@templ.Raw(exampleIcon("search", `class="yr-search-icon"`, searchIconSize))
		<input class="yr-search-input" type="search" placeholder="Search workflows, connectors…"/>
	</div>
}
