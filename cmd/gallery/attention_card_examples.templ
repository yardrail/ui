package main

import ui "github.com/yardrail/ui/pkg"

templ attentionCardDefault() {
	<div style="max-width:40rem">
		@ui.ActionCard(&ui.ActionCardProps{Urgent: true}) {
			@ui.IconBadge(ui.ToneAmber, &ui.IconBadgeProps{}) {
				@ui.IconClock()
			}
			<div class="yr-action-card-body">
				<h3 class="yr-action-card-title">Approve refund for order #1042</h3>
				<p class="yr-action-card-desc">Waiting since 2h ago · Refund triage</p>
			</div>
			<div class="yr-action-card-action">
				@ui.Pill("Waiting", &ui.PillProps{Tone: ui.ToneWarning, Pill: true})
			</div>
		}
	</div>
}

templ attentionCardDanger() {
	<div style="max-width:40rem">
		@ui.ActionCard(&ui.ActionCardProps{UrgentDanger: true}) {
			@ui.IconBadge(ui.ToneDanger, &ui.IconBadgeProps{}) {
				@ui.IconAlertTriangle()
			}
			<div class="yr-action-card-body">
				<h3 class="yr-action-card-title">Sync contacts failed</h3>
				<p class="yr-action-card-desc">Connector returned 401 · 3h ago</p>
			</div>
			<div class="yr-action-card-action">
				@ui.Pill("Failed", &ui.PillProps{Tone: ui.ToneDanger, Pill: true})
			</div>
		}
	</div>
}
