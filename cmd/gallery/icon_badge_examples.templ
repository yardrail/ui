package main

import ui "github.com/yardrail/ui/pkg"

templ iconBadgeTonesExample() {
	<div style="display:flex;flex-wrap:wrap;gap:1rem">
		@iconBadgeExampleItem("accent", ui.IconPencil())
		@iconBadgeExampleItem("amber", ui.IconMail())
		@iconBadgeExampleItem("blue", ui.IconStar())
		@iconBadgeExampleItem("green", ui.IconCheckCircle())
		@iconBadgeExampleItem("purple", ui.IconShield())
		@iconBadgeExampleItem("pink", ui.IconUser())
		@iconBadgeExampleItem("danger", ui.IconZap())
	</div>
}

templ iconBadgeExampleItem(tone string, icon templ.Component) {
	<div style="display:flex;flex-direction:column;align-items:center;gap:0.5rem">
		@ui.IconBadge(tone, &ui.IconBadgeProps{}) {
			@icon
		}
		<code style="font-size:0.75rem;color:#5C5A59">{ tone }</code>
	</div>
}
