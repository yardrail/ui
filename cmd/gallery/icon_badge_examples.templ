package main

import ui "github.com/yardrail/ui/pkg"

templ iconBadgeTonesExample() {
	<div style="display:flex;flex-wrap:wrap;gap:1rem">
		@iconBadgeExampleItem(ui.ToneAccent, ui.IconPencil())
		@iconBadgeExampleItem(ui.ToneAmber, ui.IconMail())
		@iconBadgeExampleItem(ui.ToneBlue, ui.IconStar())
		@iconBadgeExampleItem(ui.ToneGreen, ui.IconCheckCircle())
		@iconBadgeExampleItem(ui.TonePurple, ui.IconShield())
		@iconBadgeExampleItem(ui.TonePink, ui.IconUser())
		@iconBadgeExampleItem(ui.ToneDanger, ui.IconZap())
	</div>
}

templ iconBadgeExampleItem(tone ui.Tone, icon templ.Component) {
	<div style="display:flex;flex-direction:column;align-items:center;gap:0.5rem">
		@ui.IconBadge(tone, &ui.IconBadgeProps{}) {
			@icon
		}
		<code style="font-size:0.75rem;color:#5C5A59">{ tone.String() }</code>
	</div>
}
