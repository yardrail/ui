package main

import ui "github.com/yardrail/ui/pkg"

templ actionCardStacked() {
	<div style="max-width:40rem">
		@ui.Stack(ui.StackProps{Gap: ui.Space3}) {
			@ui.ActionCard(&ui.ActionCardProps{}) {
				@ui.IconBadge("accent", &ui.IconBadgeProps{}) {
					@ui.Icon("pencil")
				}
				<div class="yr-action-card-body">
					<h3 class="yr-action-card-title">Finish setting up</h3>
					<p class="yr-action-card-desc">Complete your organization setup to get started.</p>
				</div>
				<div class="yr-action-card-action">
					<a href="#" class="yr-button yr-button--secondary">Resume setup</a>
				</div>
			}
			@ui.ActionCard(&ui.ActionCardProps{}) {
				@ui.IconBadge("amber", &ui.IconBadgeProps{}) {
					@ui.Icon("mail")
				}
				<div class="yr-action-card-body">
					<h3 class="yr-action-card-title">Verify your email</h3>
					<p class="yr-action-card-desc">We sent a link to pat@example.com. Purchases stay locked until the address is verified.</p>
				</div>
				<div class="yr-action-card-action">
					<a href="#" class="yr-button yr-button--secondary">Resend email</a>
				</div>
			}
		}
	</div>
}
