package main

import ui "github.com/yardrail/ui/pkg"

templ alertTonesExample() {
	<div style="display:flex;flex-direction:column;gap:0.75rem;max-width:32rem">
		@ui.Alert(&ui.AlertProps{Tone: "success"}) {
			Your changes were saved.
		}
		@ui.Alert(&ui.AlertProps{Tone: "warning"}) {
			The connector token expires in 3 days.
		}
		@ui.Alert(&ui.AlertProps{Tone: "danger"}) {
			That username is already taken.
		}
		@ui.Alert(&ui.AlertProps{Tone: "info"}) {
			A new version of this template is available.
		}
		@ui.Alert(&ui.AlertProps{}) {
			No tone falls back to info.
		}
	</div>
}

templ alertWithIconExample() {
	<div style="display:flex;flex-direction:column;gap:0.75rem;max-width:32rem">
		@ui.Alert(&ui.AlertProps{Tone: "success"}) {
			@ui.Icon("check-circle")
			<strong>Added!</strong> The template is in your library.
		}
		@ui.Alert(&ui.AlertProps{Tone: "danger"}) {
			@ui.Icon("circle-x")
			<strong>Run failed.</strong> The webhook returned 500.
		}
	</div>
}
