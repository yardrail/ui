package main

import ui "github.com/yardrail/ui/pkg"

templ connectorBindingRowExampleRows() {
	<div style="display:flex;flex-direction:column;gap:0.75rem;max-width:36rem">
		@ui.MetaRow(&ui.MetaRowProps{}) {
			<span>email.send</span>
			<span>SendGrid</span>
			@ui.Pill("Bound", &ui.PillProps{Tone: "success", Shape: ui.ShapePill})
		}
		@ui.MetaRow(&ui.MetaRowProps{}) {
			<span>crm.read</span>
			<span>HubSpot</span>
			@ui.Pill("Bound", &ui.PillProps{Tone: "success", Shape: ui.ShapePill})
		}
		@ui.MetaRow(&ui.MetaRowProps{}) {
			<span>chat.post</span>
			@ui.Pill("Not connected", &ui.PillProps{Tone: "danger", Shape: ui.ShapePill})
			<a href="#" style="font-family:var(--yr-font-ui);font-size:var(--yr-font-size-sm);color:var(--yr-accent)">Set up</a>
		}
	</div>
}
